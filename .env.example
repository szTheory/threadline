# Threadline Docker defaults.
#
# Copy to .env only when you want persistent local overrides. Compose reads .env
# automatically from the repository root.

# Compose project names isolate containers, networks, and volumes across clones.
# If you copy this file to .env in more than one checkout, change this value in
# each checkout. Otherwise those checkouts intentionally target the same Compose
# stack. `bin/demo-up` derives a unique default automatically; see
# guides/local-docker-dx.md for the local port/project-name model.
COMPOSE_PROJECT_NAME=threadline

# Host bind addresses default to localhost so dev services are not exposed on
# every network interface.
THREADLINE_DB_HOST=127.0.0.1
THREADLINE_DB_PORT=5433

THREADLINE_DEMO_HOST=127.0.0.1
THREADLINE_DEMO_PORT=4000
# Hostname printed in demo container logs. Keep localhost unless you bind to a
# LAN-visible address intentionally.
THREADLINE_DEMO_PUBLIC_HOST=localhost
# Optional full URL printed by the demo container. `bin/demo-up --proxy` sets
# this to http://threadline.localhost so logs match the friendly proxy URL.
THREADLINE_DEMO_PUBLIC_URL=
# Compatible Elixir/OTP base image for the local Phoenix demo build. Override
# when Docker Hub is flaky and you already have a suitable image cached.
THREADLINE_DEMO_BASE_IMAGE=elixir:1.18-otp-27-slim

# Optional shared local proxy settings. These are used only when you pass
# `bin/demo-up --proxy`; the default helper path does not require Traefik.
THREADLINE_PROXY_HOST=threadline.localhost
THREADLINE_PROXY_NETWORK=proxy

THREADLINE_PGBOUNCER_HOST=127.0.0.1
THREADLINE_PGBOUNCER_PORT=6432

# Browser verification runs the Phoenix server outside Compose by default.
THREADLINE_E2E_PORT=4002
