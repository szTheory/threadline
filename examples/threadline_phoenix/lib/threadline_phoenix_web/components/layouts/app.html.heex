<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ThreadlinePhoenix</title>
    <style>
      :root {
        font-family: system-ui, sans-serif;
        line-height: 1.5;
      }
      body {
        margin: 0;
        padding: 1.5rem;
        background: #f8fafc;
        color: #0f172a;
      }
      .flash {
        padding: 0.75rem 1rem;
        border-radius: 0.375rem;
        margin-bottom: 1rem;
      }
      .flash-info {
        background: #dbeafe;
        color: #1e3a8a;
      }
      .flash-error {
        background: #fee2e2;
        color: #991b1b;
      }
      a {
        color: #2563eb;
      }
    </style>
  </head>
  <body>
    <.flash_group flash={@flash} />
    {@inner_content}
  </body>
</html>
