diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index e9331731..21fe1886 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -794,0 +795,34 @@ jobs:
+          THREADLINE_STARTUP_TRACE: ${{ matrix.lane == 'min' && '1' || '' }}
+
+      - name: Profile frozen minimum startup files (temporary diagnostic)
+        if: always() && matrix.lane == 'min'
+        timeout-minutes: 2
+        run: |
+          set -euo pipefail
+          mkdir -p tmp/ci-startup-trace
+          grep -H '^STARTUP_TRACE ' tmp/ci-test-partitions/partition-*.log > tmp/ci-startup-trace/helper.txt
+          cp test/support/startup-profile.files tmp/ci-startup-trace/frozen-files.txt
+          cp tmp/ci-test-partitions/partition-*.files tmp/ci-startup-trace/
+          readarray -t files < test/support/startup-profile.files
+          set +e
+          MIX_TEST_PARTITION=3 THREADLINE_STARTUP_TRACE=1 mix test --no-compile --no-deps-check --profile-require time "${files[@]}" > tmp/ci-startup-trace/require.txt 2>&1
+          status=$?
+          set -e
+          cat tmp/ci-startup-trace/require.txt
+          printf 'profile_exit=%s\n' "$status" > tmp/ci-startup-trace/status.txt
+          # Elixir 1.15 profiles the files, skips tests, then reports no matching tests.
+          test "$status" -le 1
+          grep -E '^\[profile\] Finished compilation cycle of [0-9]+ modules in [0-9]+ms' tmp/ci-startup-trace/require.txt
+          if grep -E '^\*\*|^== Compilation error' tmp/ci-startup-trace/require.txt; then exit 1; fi
+          if [ "$status" -eq 1 ]; then
+            grep -F 'Paths given to "mix test" did not match any directory/file:' tmp/ci-startup-trace/require.txt
+          fi
+
+      - name: Upload minimum startup trace (temporary diagnostic)
+        if: always() && matrix.lane == 'min'
+        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
+        with:
+          name: minimum-startup-trace-${{ github.run_id }}
+          path: tmp/ci-startup-trace/
+          if-no-files-found: error
+          retention-days: 14
diff --git a/test/test_helper.exs b/test/test_helper.exs
index bce355a4..1b32b6ef 100644
--- a/test/test_helper.exs
+++ b/test/test_helper.exs
@@ -0,0 +1,9 @@
+startup_trace = fn phase ->
+  if System.get_env("THREADLINE_STARTUP_TRACE") == "1" do
+    {vm_ms, _} = :erlang.statistics(:wall_clock)
+    partition = System.get_env("MIX_TEST_PARTITION", "none")
+    IO.puts("STARTUP_TRACE partition=#{partition} phase=#{phase} vm_ms=#{vm_ms}")
+  end
+end
+
+startup_trace.("helper_start")
@@ -1,0 +11 @@ ExUnit.start()
+startup_trace.("exunit_ready")
@@ -62,0 +73 @@ end
+startup_trace.("database_ready")
@@ -63,0 +75 @@ end
+startup_trace.("repo_started")
@@ -88,0 +101 @@ unless topology_pooler? do
+  startup_trace.("database_checks_done")
@@ -89,0 +103 @@ unless topology_pooler? do
+  startup_trace.("migrations_done")
@@ -98,0 +113 @@ unless topology_pooler? do
+  startup_trace.("application_stopped")
@@ -99,0 +115 @@ unless topology_pooler? do
+  startup_trace.("application_restarted")
@@ -139,0 +156,2 @@ end
+
+startup_trace.("helper_done")
