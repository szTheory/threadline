#!/usr/bin/env bash
# Per-PR supply-chain gate (SUP-02): asserts a minimum Hex client version, then
# runs `bin/verify-lock-hygiene` (REL-04, a static check that rejects an empty
# build-manager list without fetching) + `mix deps.get --check-locked` +
# `mix deps.unlock --check-unused` + `mix deps.tree --only prod` (closure-rule
# directories) + `mix hex.audit --format sarif` over every lockfile this
# repository maintains (root, bench, examples/threadline_phoenix), in that
# fixed order. `--check-locked` means
# the lock actually audited is the one committed to the repo: if mix.lock no
# longer matches mix.exs, `deps.get` fails that directory instead of silently
# re-resolving and auditing a lock other than the one on disk. Aggregates
# failures across directories rather than stopping at the first one, so a
# single `mix verify.deps_audit` run always reports the full picture.
#
# Env-var suppression (HEX_IGNORE_ADVISORIES / HEX_IGNORE_RETIREMENTS) is
# refused outright, before any `mix` call: an unaccountable bypass would
# defeat the point of a required gate. Hex's global client config
# (`mix hex.config ignore_advisories|ignore_retirements`, read from any
# HEX_HOME) is refused the same way, right after the Hex version floor check
# and before any per-directory audit call: that query is run from a fresh,
# mix.exs-free directory under this repo's gitignored tmp/, because running
# it inside a project would also pick up that project's own accountable
# `hex: [ignore_advisories: ...]` entry. The only legitimate way to suppress
# an advisory is a documented `hex_audit_ignores/0` entry on the relevant
# MixProject module (see test/threadline/ignore_advisories_contract_test.exs),
# which records a reason, a reachability claim and a review-by date.
#
# Tiered findings (SUP-03, D-16..D-21). `hex.audit` runs as
# `--format sarif --output <fresh path>` and findings come only from the SARIF
# `hexAudit/v1` fingerprint, parsed by the shared bin/deps-audit-tier library
# (the same parser bin/deps-health-report uses). A finding is BLOCKING if and
# only if its directory uses the closure rule and its package is in that
# directory's `mix deps.tree --only prod --format plain` closure (optional and
# transitive deps included; `runtime: false` is never consulted). Directory
# roles come only from the resolved path, with no env or flag seam:
#   $ROOT/bench, $ROOT/examples/threadline_phoenix  every finding non-blocking
#   the root and every other DIR argument            the closure rule
# The closure is read only after that directory's `deps.get --check-locked`
# succeeded; a failing deps.tree or an empty closure is a FAIL. Every finding
# prints one machine line
#   deps-audit-finding tier=<blocking|non-blocking> dir=<d> kind=<advisory|retirement> package=<p> id=<id>
# (id is the advisory id, or the SARIF ruleId for a retirement), plus an
# `::error::` (blocking, appended to the FAIL list) or `::warning::`
# (non-blocking, exit status unchanged) annotation, and one row in a
# $GITHUB_STEP_SUMMARY table when that is set. Non-blocking findings leave the
# exit status 0: the release lane needs a fully successful run (D-21). Every
# ambiguous audit shape (no SARIF file, unparseable SARIF, non-zero exit with
# no results, exit 0 with results, an unparseable fingerprint, an unknown kind,
# OTP below 27) is its own FAIL line (D-19). Everything other than findings
# (the Hex floor, ignore refusal, lock hygiene, --check-locked,
# --check-unused, a missing lock) stays blocking in all three directories
# (D-20).
#
# Modes:
#   bin/verify-deps-audit                  # canonical: . bench examples/threadline_phoenix
#   bin/verify-deps-audit DIR [DIR ...]    # explicit directories, in the given order
#   bin/verify-deps-audit --self-test      # proves the gate goes red (see below)
#
# `--self-test` proves the gate actually has teeth against real Hex, in five
# cases: (a) it copies a committed, deliberately vulnerable lock
# (test/fixtures/deps_audit/vulnerable_lock/) into a throwaway project under
# the repo's gitignored tmp/ and runs this gate on it (must go red, and go
# red FOR A BLOCKING ADVISORY: `tier=blocking ... package=plug
# id=EEF-CVE-2026-54892`, not vacuously); (b) repeats with a faked Hex 2.4.0
# (must go red on the version floor, without ever reaching an audit call);
# (c) sets a real global `hex.config ignore_advisories` for the fixture's
# advisory id under a throwaway HEX_HOME (must go red on the global-config
# refusal, before any audit call); (d) copies the fixture into a second
# throwaway project and edits its mix.exs so the lock no longer matches
# (must go red via `--check-locked`, with the committed lock left
# byte-identical); (e) copies the fixture into a third throwaway project
# with deps `{:plug, "== 1.19.1", only: :test}, {:telemetry, "~> 1.4"}` over
# the unchanged lock (must stay green, reporting `tier=non-blocking` for
# `package=plug id=EEF-CVE-2026-54892`: the real-Hex proof of the SUP-03
# downgrade). This is the negative network proof required by SUP-02; it
# runs as a step in the `verify-deps-audit` CI job, not as a tagged ExUnit
# test, so no network-dependent test is excluded from the default `mix test`
# lane.
#
# Seam: MIX_BIN (default `mix`) lets tests substitute a fake `mix` binary to
# exercise this script's behavior fully offline. Never used by real callers.

set -euo pipefail

die() {
  printf 'verify-deps-audit: %s\n' "$*" >&2
  exit 2
}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd -P)"
MIX_BIN="${MIX_BIN:-mix}"
# shellcheck source=bin/deps-audit-tier
source "$SCRIPT_DIR/deps-audit-tier"

# The one EXIT trap (PATTERNS hazard 2): every temp path this script creates
# is registered here, never through a second trap that would replace it.
SELF_TEST_DIR=""
NEUTRAL_HEX_CONFIG_DIR=""
cleanup_all() {
  [ -z "$SELF_TEST_DIR" ] || rm -rf "$SELF_TEST_DIR"
  [ -z "$NEUTRAL_HEX_CONFIG_DIR" ] || rm -rf "$NEUTRAL_HEX_CONFIG_DIR"
  dat_cleanup
}
trap cleanup_all EXIT

# The floor is a literal, never environment-overridable. Bumping it is a
# deliberate, reviewed edit to this file. It must equal the CI Hex pin
# (`mix local.hex X.Y.Z --force`), enforced by hex_pin_contract_test.exs. CI
# runs exactly that pin; this local check is only a floor: it refuses an older
# Hex and allows a newer one, which is then not what CI runs.
MIN_HEX="2.6.0"

# --- Refuse the env-var bypass before any mix call ---------------------------

if [ -n "${HEX_IGNORE_ADVISORIES:-}" ]; then
  die "HEX_IGNORE_ADVISORIES is set. Suppressing a hex.audit finding via an environment variable is not accountable. Add a hex_audit_ignores/0 entry (reason, reachability, review-by date) to the relevant MixProject module instead."
fi
if [ -n "${HEX_IGNORE_RETIREMENTS:-}" ]; then
  die "HEX_IGNORE_RETIREMENTS is set. Suppressing a hex.audit finding via an environment variable is not accountable. Add a hex_audit_ignores/0 entry (reason, reachability, review-by date) to the relevant MixProject module instead."
fi

# --- version_ge: numeric (never lexical/string) MAJOR.MINOR.PATCH compare ---

version_ge() {
  local a_str="$1" b_str="$2"
  local -a a b
  IFS='.' read -r -a a <<<"$a_str"
  IFS='.' read -r -a b <<<"$b_str"
  local i
  for i in 0 1 2; do
    local av="${a[i]:-0}" bv="${b[i]:-0}"
    if [ "$av" -gt "$bv" ]; then
      return 0
    fi
    if [ "$av" -lt "$bv" ]; then
      return 1
    fi
  done
  return 0
}

# --- --self-test mode ---------------------------------------------------------

if [ "${1:-}" = "--self-test" ]; then
  fixture_dir="$ROOT/test/fixtures/deps_audit/vulnerable_lock"
  [ -f "$fixture_dir/mix.exs" ] && [ -f "$fixture_dir/mix.lock" ] ||
    die "self-test fixture missing at $fixture_dir"

  mkdir -p "$ROOT/tmp"
  SELF_TEST_DIR="$(mktemp -d "$ROOT/tmp/deps-audit-self-test.XXXXXX")"
  self_test_dir="$SELF_TEST_DIR"

  project_dir="$self_test_dir/project"
  mkdir -p "$project_dir"
  cp "$fixture_dir/mix.exs" "$project_dir/mix.exs"
  cp "$fixture_dir/mix.lock" "$project_dir/mix.lock"

  # (a) The committed vulnerable lock must go red, and go red FOR AN ADVISORY.
  set +e
  vuln_output="$(HEX_IGNORE_ADVISORIES= HEX_IGNORE_RETIREMENTS= "$0" "$project_dir" 2>&1)"
  vuln_status=$?
  set -e

  [ "$vuln_status" -ne 0 ] ||
    die "gate stayed green on a known-vulnerable lock"
  grep -q 'deps-audit-finding tier=blocking .*package=plug id=EEF-CVE-2026-54892' <<<"$vuln_output" ||
    die "gate went red for a reason other than a blocking plug advisory (vacuous red): $vuln_output"

  # (b) A faked old Hex must be refused before any mix call runs beyond hex.info.
  fake_mix_dir="$self_test_dir/fake-mix-bin"
  mkdir -p "$fake_mix_dir"
  fake_mix="$fake_mix_dir/mix"
  fake_log="$self_test_dir/fake-mix.log"
  : >"$fake_log"
  cat >"$fake_mix" <<EOF
#!/usr/bin/env bash
set -u
if [ "\$1" = "hex.info" ]; then
  printf 'Hex:    2.4.0\n'
  exit 0
fi
printf '%s\n' "\$*" >> "$fake_log"
exit 97
EOF
  chmod +x "$fake_mix"

  set +e
  old_hex_output="$(MIX_BIN="$fake_mix" HEX_IGNORE_ADVISORIES= HEX_IGNORE_RETIREMENTS= "$0" "$project_dir" 2>&1)"
  old_hex_status=$?
  set -e

  [ "$old_hex_status" -ne 0 ] ||
    die "gate stayed green with a faked Hex 2.4.0"
  grep -q "requires Hex >= $MIN_HEX" <<<"$old_hex_output" &&
    grep -q '2.4.0' <<<"$old_hex_output" ||
    die "old-Hex case failed for a reason other than the version floor: $old_hex_output"
  [ ! -s "$fake_log" ] ||
    die "old-Hex case ran a mix subcommand beyond hex.info: $(cat "$fake_log")"

  # (c) A non-empty global Hex ignore_advisories must be refused, against
  # real Hex, before any audit call.
  hex_home="$self_test_dir/hex-home"
  mkdir -p "$hex_home"
  (
    cd "$self_test_dir" &&
      HEX_HOME="$hex_home" "$MIX_BIN" hex.config ignore_advisories EEF-CVE-2026-54892
  ) >/dev/null ||
    die "self-test setup: could not set a global hex.config ignore_advisories for case (c)"

  set +e
  global_ignore_output="$(HEX_HOME="$hex_home" HEX_IGNORE_ADVISORIES= HEX_IGNORE_RETIREMENTS= "$0" "$project_dir" 2>&1)"
  global_ignore_status=$?
  set -e

  [ "$global_ignore_status" -ne 0 ] &&
    grep -q 'global Hex config sets ignore_advisories' <<<"$global_ignore_output" &&
    ! grep -q 'audit clean' <<<"$global_ignore_output" ||
    die "global hex.config ignore_advisories was not refused (CR-01 regression): $global_ignore_output"

  # (d) A mix.lock that no longer matches mix.exs must fail via
  # --check-locked instead of being silently re-resolved and audited, and
  # the committed lock must come out byte-identical.
  drift_dir="$self_test_dir/drift"
  mkdir -p "$drift_dir"
  cp "$fixture_dir/mix.exs" "$drift_dir/mix.exs"
  cp "$fixture_dir/mix.lock" "$drift_dir/mix.lock"
  cp "$fixture_dir/mix.lock" "$drift_dir/mix.lock.before"

  orig_mix_exs="$(cat "$drift_dir/mix.exs")"
  drifted_mix_exs="${orig_mix_exs//== 1.19.1/~> 1.19.2}"
  printf '%s\n' "$drifted_mix_exs" >"$drift_dir/mix.exs"

  set +e
  drift_output="$(HEX_IGNORE_ADVISORIES= HEX_IGNORE_RETIREMENTS= "$0" "$drift_dir" 2>&1)"
  drift_status=$?
  set -e

  [ "$drift_status" -ne 0 ] &&
    grep -q -- '--check-locked' <<<"$drift_output" &&
    ! grep -q 'audit clean' <<<"$drift_output" &&
    cmp -s "$drift_dir/mix.lock" "$drift_dir/mix.lock.before" ||
    die "lock drift was not refused (WR-02 regression): $drift_output"

  # (e) The same vulnerable lock with plug declared `only: :test` must stay
  # green and report the advisory as non-blocking: real-Hex proof of the
  # SUP-03 downgrade, and a tripwire for SARIF format drift. mix.lock does not
  # record `only:`, so --check-locked still passes on the unchanged lock. The
  # second dep (telemetry, already in the lock) keeps the `--only prod`
  # closure non-empty, which an all-test-only project would fail closed on.
  nonblocking_dir="$SELF_TEST_DIR/nonblocking"
  mkdir -p "$nonblocking_dir"
  cp "$fixture_dir/mix.exs" "$nonblocking_dir/mix.exs"
  cp "$fixture_dir/mix.lock" "$nonblocking_dir/mix.lock"
  cp "$fixture_dir/mix.lock" "$nonblocking_dir/mix.lock.before"

  orig_mix_exs="$(cat "$nonblocking_dir/mix.exs")"
  plug_dep='{:plug, "== 1.19.1"}'
  test_only_deps='{:plug, "== 1.19.1", only: :test}, {:telemetry, "~> 1.4"}'
  test_only_mix_exs="${orig_mix_exs//"$plug_dep"/$test_only_deps}"
  [ "$test_only_mix_exs" != "$orig_mix_exs" ] ||
    die "self-test setup: case (e) could not rewrite $plug_dep in the fixture mix.exs"
  printf '%s\n' "$test_only_mix_exs" >"$nonblocking_dir/mix.exs"

  set +e
  nonblocking_output="$(HEX_IGNORE_ADVISORIES= HEX_IGNORE_RETIREMENTS= "$0" "$nonblocking_dir" 2>&1)"
  nonblocking_status=$?
  set -e

  [ "$nonblocking_status" -eq 0 ] &&
    grep -q 'deps-audit-finding tier=non-blocking .*package=plug id=EEF-CVE-2026-54892' <<<"$nonblocking_output" &&
    ! grep -q 'deps-audit-finding tier=blocking' <<<"$nonblocking_output" &&
    cmp -s "$nonblocking_dir/mix.lock" "$nonblocking_dir/mix.lock.before" ||
    die "test-only plug advisory was not downgraded to non-blocking (SUP-03 case (e)): $nonblocking_output"

  printf 'verify-deps-audit self-test: ok (vulnerable lock red, old Hex red, global Hex ignore red, lock drift red, test-only advisory non-blocking)\n'
  exit 0
fi

# --- Resolve the directory list -----------------------------------------------

# Canonical audit order (never env-overridable): . bench examples/threadline_phoenix
CANONICAL_DIRS=(. bench examples/threadline_phoenix)

DIRS=("$@")
if [ ${#DIRS[@]} -eq 0 ]; then
  DIRS=("${CANONICAL_DIRS[@]}")
fi

SEEN_DIRS=()
for d in "${DIRS[@]}"; do
  for prior in ${SEEN_DIRS[@]+"${SEEN_DIRS[@]}"}; do
    if [ "$prior" = "$d" ]; then
      die "duplicate directory argument: $d"
    fi
  done
  SEEN_DIRS+=("$d")
done

resolve_dir() {
  local d="$1"
  case "$d" in
    /*) printf '%s' "$d" ;;
    *) printf '%s' "$ROOT/$d" ;;
  esac
}

# --- Hex version floor, checked once, before any audit -----------------------

set +e
hex_info_output="$(cd "$ROOT" && "$MIX_BIN" hex.info 2>&1)"
set -e

hex_version_line="$(printf '%s\n' "$hex_info_output" | grep -m1 '^Hex:' || true)"
hex_version="$(printf '%s' "$hex_version_line" | sed -E 's/^Hex:[[:space:]]*([0-9]+\.[0-9]+\.[0-9]+).*/\1/')"

if [ -z "$hex_version" ] || [ "$hex_version" = "$hex_version_line" ]; then
  die "could not determine Hex version (mix hex.info output: ${hex_version_line:-<empty>})"
fi

if ! version_ge "$hex_version" "$MIN_HEX"; then
  die "requires Hex >= $MIN_HEX, found $hex_version"
fi

# --- Refuse a non-empty global Hex ignore before any per-dir audit -----------
#
# Hex's global client config (`mix hex.config ignore_advisories|ignore_retirements`,
# read from any HEX_HOME) can suppress the exact advisories this gate exists
# to catch, entirely outside the accountable hex_audit_ignores/0 convention.
# The query MUST run from a directory with no mix.exs: inside this project,
# `mix hex.config KEY` also merges this project's own accountable
# `hex: [ignore_advisories: ...]` entry, which would wrongly refuse a
# legitimate SUP-03 ignore.

read_global_hex_ignore() {
  local key="$1" neutral_dir="$2"
  local raw status non_blank start_line value

  set +e
  raw="$(cd "$neutral_dir" && "$MIX_BIN" hex.config "$key" 2>&1)"
  status=$?
  set -e

  raw="$(printf '%s' "$raw" | sed -E 's/\x1b\[[0-9;]*[A-Za-z]//g')"
  non_blank="$(printf '%s\n' "$raw" | grep -v '^[[:space:]]*$' || true)"

  # The list Hex reports is a single Elixir term that may itself wrap across
  # multiple lines (long ignore lists do). Find the first non-blank line that
  # starts with `[` and join it through the rest of the output into one
  # value, so a wrapped `["A", "B",\n "C"]` reads as one term rather than
  # only its last fragment. Any line(s) before that (warnings) are dropped.
  start_line="$(printf '%s\n' "$non_blank" | grep -n '^[[:space:]]*\[' | head -n1 | cut -d: -f1 || true)"
  if [ -z "$start_line" ]; then
    value=""
  else
    value="$(printf '%s\n' "$non_blank" | tail -n +"$start_line" | tr '\n' ' ' | tr -s '[:space:]' ' ')"
    value="$(printf '%s' "$value" | sed -E 's/^[[:space:]]+|[[:space:]]+$//g')"
  fi

  printf '%s\n%s' "$status" "$value"
}

refuse_global_hex_ignores() {
  mkdir -p "$ROOT/tmp"
  local neutral_dir
  NEUTRAL_HEX_CONFIG_DIR="$(mktemp -d "$ROOT/tmp/deps-audit-hex-config.XXXXXX")"
  neutral_dir="$NEUTRAL_HEX_CONFIG_DIR"

  local key
  for key in ignore_advisories ignore_retirements; do
    local result status value
    result="$(read_global_hex_ignore "$key" "$neutral_dir")"
    status="$(printf '%s\n' "$result" | sed -n '1p')"
    value="$(printf '%s\n' "$result" | tail -n +2)"

    if [ "$status" -ne 0 ] || [ -z "$value" ] || [ "${value#[}" = "$value" ]; then
      die "could not read global Hex config $key (mix hex.config $key exited $status): $value"
    fi

    if [ "$value" != "[]" ]; then
      die "global Hex config sets $key to $value (mix hex.config $key). Suppressing a hex.audit finding through Hex client config is not accountable. Remove it (mix hex.config $key --delete) and add a hex_audit_ignores/0 entry (reason, reachability, review-by date) to the relevant MixProject module instead."
    fi
  done

  rm -rf "$neutral_dir"
  NEUTRAL_HEX_CONFIG_DIR=""
}

refuse_global_hex_ignores

# --- Per-directory audit, aggregated (never fail-fast) ------------------------

FAILURES=()
NON_BLOCKING_COUNT=0
SUMMARY_HEADER_WRITTEN=0

# shape_fail_label REASON: the distinct D-19 FAIL text for one audit shape
# error reported by dat_audit_shape_error.
shape_fail_label() {
  case "$1" in
    "SARIF needs OTP 27+"*) printf 'SARIF needs OTP 27+' ;;
    "hex.audit exited "*" and wrote no SARIF file") printf 'SARIF output missing' ;;
    "SARIF file could not be parsed"* | "SARIF results could not be parsed"* | "parsed "*" findings from "*)
      printf 'SARIF output unparseable'
      ;;
    "hex.audit exited 0 with "*) printf 'hex.audit exited 0 with findings (unclassifiable)' ;;
    "hex.audit exited "*" with zero SARIF results")
      local n="${1#hex.audit exited }"
      printf 'hex.audit exited %s with no SARIF results' "${n%% *}"
      ;;
    "unparseable hexAudit/v1 fingerprint"*) printf 'unparseable fingerprint' ;;
    "unexpected hex.audit finding kind: "*) printf 'unknown finding kind %s' "${1#unexpected hex.audit finding kind: }" ;;
    *) printf 'unclassifiable hex.audit result' ;;
  esac
}

# summary_row DIR PACKAGE KIND ID TIER REASON: one $GITHUB_STEP_SUMMARY table
# row per finding (D-18), header written once. SARIF-derived text only ever
# reaches printf as a %s argument; `|` is escaped so a cell cannot split.
summary_row() {
  [ -n "${GITHUB_STEP_SUMMARY:-}" ] || return 0
  if [ "$SUMMARY_HEADER_WRITTEN" -eq 0 ]; then
    {
      printf '### verify-deps-audit findings\n\n'
      printf '| dir | package | kind | id | tier | why |\n'
      printf '|---|---|---|---|---|---|\n'
    } >>"$GITHUB_STEP_SUMMARY"
    SUMMARY_HEADER_WRITTEN=1
  fi
  local cells=() cell
  for cell in "$@"; do
    cells+=("${cell//|/\\|}")
  done
  printf '| %s | %s | %s | %s | %s | %s |\n' "${cells[@]}" >>"$GITHUB_STEP_SUMMARY"
}

for d in "${DIRS[@]}"; do
  resolved="$(resolve_dir "$d")"

  if [ ! -d "$resolved" ] || [ ! -f "$resolved/mix.exs" ] || [ ! -f "$resolved/mix.lock" ]; then
    FAILURES+=("FAIL $d: missing directory, mix.exs, or mix.lock at $resolved")
    continue
  fi

  # REL-04: a static lock check that never fetches, so a warm deps/ cannot
  # hide an empty build-manager list that CI's cold fetch would reject. A
  # failure here is recorded and the directory still runs its fetch and
  # audit, so one run reports everything.
  set +e
  hygiene_output="$("$SCRIPT_DIR/verify-lock-hygiene" "$resolved/mix.lock" 2>&1)"
  hygiene_status=$?
  set -e

  if [ "$hygiene_status" -ne 0 ]; then
    printf '%s\n' "$hygiene_output"
    if [ "$hygiene_status" -eq 1 ]; then
      FAILURES+=("FAIL $d: lock hygiene exited 1 (an empty build-manager list in mix.lock passes against a warm deps/ and fails CI's cold fetch; see the lines above)")
    else
      FAILURES+=("FAIL $d: lock hygiene could not check mix.lock (usage, missing file, parse error or malformed entry; see the lines above)")
    fi
  fi

  # REL-03: bin/retry-network retries a transient fetch failure with backoff
  # and stops at once on a lock mismatch (`mix.lock is out of date`), so lock
  # drift still fails on the first attempt. It feeds each attempt the `n`
  # that answers any interactive Mix prompt as a here-string, never
  # `printf 'n\n' | mix ...`: under `set -o pipefail` that pipeline's status
  # also counts printf, which fails (EPIPE, or SIGPIPE 141) whenever mix exits
  # without reading stdin before printf writes. That race turned a successful
  # fetch into a spurious non-zero status.
  set +e
  deps_get_output="$(cd "$resolved" && "$SCRIPT_DIR/retry-network" "$MIX_BIN" deps.get --check-locked 2>&1)"
  deps_get_status=$?
  set -e

  if [ "$deps_get_status" -ne 0 ]; then
    printf '%s\n' "$deps_get_output"
    FAILURES+=("FAIL $d: deps.get --check-locked exited $deps_get_status (the committed mix.lock must match mix.exs; this gate audits the committed lock, never a re-resolved one — re-lock locally and commit mix.lock)")
    # A vacuous audit (deps not fetched, or fetched against a re-resolved
    # lock other than the one committed) is skipped, not trusted.
    continue
  fi

  set +e
  unlock_output="$(cd "$resolved" && "$MIX_BIN" deps.unlock --check-unused 2>&1)"
  unlock_status=$?
  set -e

  if [ "$unlock_status" -ne 0 ]; then
    printf '%s\n' "$unlock_output"
    FAILURES+=("FAIL $d: deps.unlock --check-unused exited $unlock_status")
  fi

  # SUP-03 tiering. A fresh, registered temp dir per directory holds both the
  # never-pre-created SARIF path and the closure file, so parallel or
  # interrupted runs never read a stale or foreign SARIF (D-19).
  dat_new_sarif_path && sarif_status=0 || sarif_status=$?
  sarif_path="$DAT_SARIF_PATH"
  if [ "$sarif_status" -ne 0 ] || [ -z "$sarif_path" ]; then
    FAILURES+=("FAIL $d: could not create a SARIF temp directory under $ROOT/tmp")
    continue
  fi

  role="$(dat_role "$resolved")"
  closure_file=""
  if [ "$role" = "closure" ]; then
    # Only after a successful --check-locked fetch (RESEARCH correction 2).
    closure_file="$(dirname "$sarif_path")/closure.txt"
    dat_closure "$resolved" "$closure_file" && tree_status=0 || tree_status=$?
    if [ "$tree_status" -eq 1 ]; then
      printf '%s\n' "$DAT_TREE_OUTPUT"
      FAILURES+=("FAIL $d: deps.tree --only prod exited $DAT_TREE_STATUS (the runtime closure decides which findings block; no audit was trusted)")
      continue
    fi
    if [ "$tree_status" -ne 0 ]; then
      printf '%s\n' "$DAT_TREE_OUTPUT"
      FAILURES+=("FAIL $d: empty runtime closure (mix deps.tree --only prod --format plain listed no packages; no audit was trusted)")
      continue
    fi
  fi

  # Findings come only from the SARIF hexAudit/v1 fingerprint (D-18). Not
  # wrapped in bin/retry-network: real findings also exit 1 (D-19).
  dat_audit "$resolved" "$sarif_path" && audit_status=0 || audit_status=$?
  shape_error="$(dat_audit_shape_error "$audit_status" "$sarif_path")" && shape_ok=1 || shape_ok=0

  if [ "$shape_ok" -ne 1 ]; then
    printf '%s\n' "$DAT_AUDIT_OUTPUT"
    FAILURES+=("FAIL $d: $(shape_fail_label "$shape_error") ($shape_error)")
    continue
  fi

  findings="$(dat_findings "$sarif_path")" && findings_status=0 || findings_status=$?
  if [ "$findings_status" -ne 0 ]; then
    FAILURES+=("FAIL $d: SARIF output unparseable (jq exited $findings_status)")
    continue
  fi

  [ -z "$findings" ] || printf '%s\n' "$DAT_AUDIT_OUTPUT"

  while IFS="$(printf '\t')" read -r f_kind f_pkg f_id _f_msg; do
    [ -n "$f_kind" ] || continue
    tier="$(dat_tier "$role" "$f_pkg" "$closure_file")"
    reason="$(dat_reason "$tier" "$role" "$f_pkg" "$d")"
    dat_machine_line "$tier" "$d" "$f_kind" "$f_pkg" "$f_id"
    if [ "$tier" = "blocking" ]; then
      printf '::error::%s: %s %s %s\n' "$reason" "$f_kind" "$f_pkg" "$f_id"
      FAILURES+=("FAIL $d: blocking $f_kind $f_pkg $f_id ($reason)")
    else
      printf '::warning::%s: %s %s %s\n' "$reason" "$f_kind" "$f_pkg" "$f_id"
      NON_BLOCKING_COUNT=$((NON_BLOCKING_COUNT + 1))
    fi
    summary_row "$d" "$f_pkg" "$f_kind" "$f_id" "$tier" "$reason"
  done <<EOF
$findings
EOF
done

if [ ${#FAILURES[@]} -gt 0 ]; then
  printf '%s\n' "${FAILURES[@]}"
  exit 1
fi

printf 'verify-deps-audit: %d lockfile(s) audit clean (Hex %s; %d non-blocking finding(s))\n' "${#DIRS[@]}" "$hex_version" "$NON_BLOCKING_COUNT"
exit 0
