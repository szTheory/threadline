#!/usr/bin/env bash
# Fail-closed partitioned test runner (SUITE-02). Called by both the
# `verify-test` CI step ("Run tests" -> `mix verify.test_partitioned`) and the
# `mix verify.test_partitioned` alias, so CI and a local run always exercise
# the exact same committed script.
#
# Compiles once, serially, then starts N concurrent `mix test <files...>`
# processes, each on its own `threadline_test<i>` database (config/test.exs,
# D-04), each writing its own partition-<i>.log and partition-<i>.status.
# Every background PID is recorded and waited on individually with
# `wait "$pid" || fail=1` -- never a bare `wait` (always returns 0) and never
# `a & b & wait` (returns only the last job's status). On any partition
# failure, only the failing partitions' logs are printed, and the script
# exits non-zero. Each partition runs in its own process group (`set -m`
# around the fork loop, so the group id is the partition subshell's PID). An
# INT or TERM signal kills every partition's process group (TERM, then KILL
# after the kill grace) and exits non-zero, so a cancelled job leaves no
# orphan and never reports success.
#
# Budget watchdog (D-14). Before the per-PID wait loop, watch_partitions polls
# every partition with `kill -0` and its age since the fork. A partition
# older than CI_TEST_PARTITIONS_BUDGET_S prints `ci-test-partitions: partition
# <i> exceeded budget <s>s`. Unless its log already holds the in-VM monitor's
# `HANG: in-flight:` block, the watchdog sends QUIT to that partition's BEAM
# (ExUnit's own trap prints `Aborting test suite` with the unfinished tests)
# and waits up to 30 s for either marker. With neither, it prints a backstop:
# the last 40 log lines, the partition's process tree and, when psql exists,
# pg_stat_activity for threadline_test<i>. Then it sends TERM to the process
# group, waits 10 s, sends KILL to the group and to any descendant from a
# pre-kill snapshot that left the group (same PID and start time only). The
# partition is recorded as `status=124 reason=budget`, its report row shows
# Exit 124, and a `Hung partitions` table names its in-flight tests (at most
# 10 lines of 100 characters; never stacks or raw log text). Stacks and the
# backstop go to stdout and the partition log only. Portable to macOS
# /bin/bash 3.2: no timeout, gtimeout, setsid or `wait -n`.
#
# The report ends with a `| max/min | - | <ratio> | - |` row: slowest over
# fastest partition seconds, over partitions with at least one file. Above
# 1.15 it prints `::warning::partition ratio <r> exceeds 1.15` on stdout only
# (D-12). It never changes the exit status.
#
# File assignment (D-03a). The script enumerates the test files exactly as
# plain `mix test` would (mix.exs sets no test_paths/test_pattern, so Mix's
# defaults: every `*_test.exs` under `test/`, hidden paths skipped) and
# assigns each file to one partition by measured weight, read from the
# committed test/partition_weights.txt (`<milliseconds> <test file>` per
# line). Async files (the file contains `async: true`) count at
# ASYNC_FACTOR_PERMILLE thousandths of their measured time, because a real
# run overlaps them; the factor is fitted from CI partition timings (below). A file with no weight gets the median
# weight; a weight entry for a file that no longer exists is ignored.
# Assignment is greedy longest-first into the least-loaded partition, ties
# broken by path then by lowest partition number, so it is deterministic.
# Mix's own `--partitions` flag is not used: it assigns files round-robin
# over the sorted list, which measured badly unbalanced on CI run
# 36792875477 (partition seconds 67/217/119).
#
# Lane scope (D-10). THREADLINE_TEST_SCOPE picks which enumerated files a
# lane runs. Empty or unset (local runs, the current CI lane) runs every
# file. `toolchain` (the min and latest CI lanes) drops every file holding a
# line that is exactly `@moduletag :repo_contract` (a repo-file contract whose
# outcome does not depend on the Elixir/OTP/PostgreSQL toolchain), prints
# `ci-test-partitions: <n> repo-contract files run on the current lane only`
# to stdout and the step summary, and the exactly-once check below runs
# against that filtered set. Any other value exits 2. `:repo_contract` is not
# an ExUnit exclude: plain `mix test` runs those files.
#
# Files listed together on one line of test/partition_colocate.txt always
# share a partition (tests that write into the shared checkout or snapshot
# its `git status`, which must not overlap); a group is placed as one unit.
#
# Stale weights can only make the partitions less even, never drop or
# duplicate a test: before anything runs, the script checks that the union
# of all partitions' files equals the enumerated file set with no
# duplicates, and exits 1 with the difference if it does not. A partition
# that is assigned no files does not invoke mix at all (a bare `mix test`
# would run the whole suite); it reports exit 0 with no tests, and can never
# mask a sibling's failure.
#
# A per-partition and whole-step timing/counts table is printed to stdout
# and, when set, appended to $GITHUB_STEP_SUMMARY -- partition numbers, exit
# codes, seconds and integer ExUnit counts only, never raw log text.
#
# Modes:
#   bin/ci-test-partitions          # N defaults to 4 (225-CONTEXT.md D-03b:
#                                    # at N=3 the stress router test, whose
#                                    # cold nested prod build costs far more
#                                    # in CI than locally, shared a partition
#                                    # and set the step time (CI run
#                                    # 36804809428); at N=4 its weight exceeds
#                                    # an even share, so it runs alone)
#   bin/ci-test-partitions N        # explicit partition count, 1-8
#   bin/ci-test-partitions --write-weights
#                                    # run the whole suite once, unpartitioned,
#                                    # with `mix test --slowest-modules 1000`
#                                    # and rewrite test/partition_weights.txt
#                                    # from its per-module timings (summed per
#                                    # file). Needs Elixir >= 1.17 and the
#                                    # local test database.
#   bin/ci-test-partitions --ingest-weights <dir> [--lane <name>] [--output <committed-weight-path>]
#                                    # rewrite test/partition_weights.txt from
#                                    # the partition-timings-*.tsv files the
#                                    # partition monitor wrote on CI (found
#                                    # anywhere under <dir>): per file, the
#                                    # median wall_ms across the TSVs (the
#                                    # lower middle value for an even count).
#                                    # Files absent from the TSVs keep their
#                                    # current weight. With --lane, only TSVs
#                                    # whose header says lane=<name> are read.
#                                    # Prints `moved >2x: <old> -> <new>
#                                    # <file>` for every large change.
#                                    # --write-weights stays as the offline
#                                    # fallback.
#   bin/ci-test-partitions --self-test
#   bin/ci-test-partitions -h
#
# Partition monitor (real-path env, not test-only seams). Every partition's
# `mix test` gets `--formatter ExUnit.CLIFormatter --formatter
# Threadline.Test.PartitionMonitor` (test/support/partition_monitor.ex) after
# its files, so the normal ExUnit output is unchanged and plain `mix test`
# never loads the monitor. Each partition is started with:
#   THREADLINE_TEST_DEADLINE_MS       CI_TEST_PARTITIONS_BUDGET_S x 1000 - 30000.
#                                     A VM-relative deadline: when the VM has
#                                     run this long, the monitor prints a
#                                     `HANG: in-flight:` block naming the
#                                     running tests with stacks and halts the
#                                     VM. Zero or less disarms it.
#   THREADLINE_PARTITION_TIMINGS_FILE $log_dir/partition-timings-<i>.tsv, the
#                                     per-file timings --ingest-weights reads.
#   CI_TEST_PARTITIONS_BUDGET_S       per-partition wall budget in seconds,
#                                     default 480, a positive integer.
#   THREADLINE_TEST_SCOPE             empty/unset (every file) or `toolchain`
#                                     (drop `@moduletag :repo_contract`
#                                     files); see Lane scope above.
#
# Seams (all test-only, never used by real callers):
#   MIX_BIN                       (default `mix`) lets --self-test substitute
#                                  a fake `mix` binary to exercise this
#                                  script's aggregation and flag-passing fully
#                                  offline.
#   CI_TEST_PARTITIONS_LOG_DIR    (default $ROOT/tmp/ci-test-partitions) lets
#                                  --self-test redirect partition logs into a
#                                  throwaway directory instead of the real one.
#   CI_TEST_PARTITIONS_DIAG_WAIT_S  (default 30) seconds the watchdog waits
#                                  after QUIT for an in-VM report.
#   CI_TEST_PARTITIONS_KILL_GRACE_S (default 10) seconds between the group
#                                  TERM and the group KILL.
#   CI_TEST_PARTITIONS_PSQL       (default `psql`) the backstop's
#                                  pg_stat_activity client.
#   CI_TEST_PARTITIONS_REPORT_ONLY  a directory of prepared partition-<i>
#                                  status/files/log files: print only the
#                                  report for them and exit 0.
#   These four let --self-test shrink the hang cases to seconds and stay
#   offline.
#
# --self-test runs a copy of this script inside a throwaway project (its own
# test/ tree and weights file) with a fake `mix`, fully offline, and proves
# the gate actually has teeth, in these cases: (a) every partition passing
# exits 0; (b) one failing partition exits 1 and only that partition's log
# is printed; (c) two failing partitions exit 1 with their logs printed in
# ascending order; (d) an empty partition alongside a failing one still
# exits 1; (e) an empty partition alongside passing ones still exits 0 (an
# empty partition never masks or is mistaken for a failure); (f) a killed
# partition exits non-zero; (g) the step summary lists partitions in
# ascending order; (h) N of 0, -1, "abc" and "" each exit 2 with a usage
# line; (i) every enumerated test file is handed to exactly one partition;
# (j) a file with no weight still runs; (k) a stale weight entry is ignored;
# (l) the assignment is identical across two runs; (m) the heaviest files
# land in different partitions; (n) a partition assigned no files never
# invokes mix, exits 0 on its own and does not mask a failing sibling; (o)
# the exactly-once check rejects a duplicated, a dropped and an
# out-of-range assignment; (p) --write-weights turns `--slowest-modules`
# output into a sorted per-file weights file; (q) files grouped on one line
# of a colocate file share a partition, still exactly once; (r)
# --ingest-weights takes the per-file median over partition-timings TSVs,
# keeps absent files' weights and the header, sorts by path, reports a >2x
# move, rejects malformed rows, and with --lane reads only that lane's TSVs
# (an invalid or unmatched lane exits 2); (s) a hung partition that ignores
# QUIT is stopped at a 3 s budget with the backstop, a group TERM, Exit 124
# and no leftover process; (t) one that also ignores TERM is escalated to
# SIGKILL; (u) one that answers QUIT with ExUnit's abort list skips the
# backstop and has its unfinished tests named in the summary; (v) the
# max/min row is 1.30 with a stdout-only warning for 10/11/12/13 s, 1.10 with
# none for 10/10/11/11 s, ignores zero-file partitions and is n/a with no
# known times, and the report still exits 0; (w) with
# THREADLINE_TEST_SCOPE=toolchain an added 8th sandbox file tagged
# `@moduletag :repo_contract` is in no partition,
# the exactly-once check passes and the output and summary name 1
# repo-contract file; unset or empty it runs exactly once; `bogus` exits 2
# with a usage line; (x) ASYNC_FACTOR_PERMILLE=250 reproduces the old 1/4
# sandbox assignment exactly and the fitted constant scales the async file.
# The partitions also receive the monitor formatter and its env. This is the runtime mutation
# control D-10 names -- it runs as the unconditional CI step "Prove the gate
# goes red (failing partition)" before "Run tests" on every lane.

set -euo pipefail

die() {
  printf 'ci-test-partitions: %s\n' "$*" >&2
  exit 2
}

usage() {
  cat <<'EOF'
Usage: bin/ci-test-partitions [N]
       bin/ci-test-partitions --write-weights
       bin/ci-test-partitions --ingest-weights <dir> [--lane <name>] [--output <committed-weight-path>]
       bin/ci-test-partitions --self-test
       bin/ci-test-partitions -h

N is a positive integer from 1 to 8. Omit it to use the default (4, per
225-CONTEXT.md D-03b). --write-weights refreshes test/partition_weights.txt
from one full local run. --ingest-weights refreshes it from the
partition-timings-*.tsv files under <dir> (per-file median), optionally only
those whose header says lane=<name>.

THREADLINE_TEST_SCOPE is empty or unset (run every test file) or `toolchain`
(skip files tagged `@moduletag :repo_contract`, as the min and latest CI
lanes do).
EOF
}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
SCRIPT_PATH="$SCRIPT_DIR/$(basename "${BASH_SOURCE[0]}")"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd -P)"
MIX_BIN="${MIX_BIN:-mix}"
WEIGHTS_REL="test/partition_weights.txt"
COLOCATE_REL="test/partition_colocate.txt"
# Async files count at this many thousandths of their weight (247 D-11).
# Fitted 2026-10-26 by least squares, k = sum((y - S) * A) / sum(A^2), over
# 3 runs x 4 current-lane partitions (main runs 40394247390, 40396194471,
# 40398138085; partition-timings-current TSVs), where y = partition wall_ms
# - boot_ms, S = summed sync file walls, A = summed async file walls:
# k=0.2918, residual RMS=13994 ms over partitions of 101-231 s. Replaces the
# guessed 1/4 (250). Refit with the same TSVs whenever the weights refresh.
ASYNC_FACTOR_PERMILLE=292
PARTITION_TEST_TIMEOUT_MS=180000
# D-10: a line that is exactly this module tag marks a repo-file contract
# test, which THREADLINE_TEST_SCOPE=toolchain drops. Pinned by
# test/threadline/repo_contract_scope_contract_test.exs (rule filter-literal).
REPO_CONTRACT_TAG_RE='^[[:space:]]*@moduletag :repo_contract[[:space:]]*$'

# --- Test file enumeration and weighted assignment -----------------------------

# The set plain `mix test` runs: mix.exs sets neither test_paths nor
# test_pattern, so Mix uses `test` and `*_test.exs`; Path.wildcard skips
# hidden files and directories, and so does this. Run from $ROOT.
enumerate_test_files() {
  find test -type f -name '*_test.exs' ! -path '*/.*' | LC_ALL=C sort
}

# Only these lane selectors are accepted, before compilation or test execution.
lane_weights() {
  case "$1" in
    ''|current) printf '%s\n' "$WEIGHTS_REL" ;;
    min) printf '%s\n' 'test/partition_weights_min.txt' ;;
    latest) printf '%s\n' 'test/partition_weights_latest.txt' ;;
    *) die "unknown THREADLINE_CI_LANE: $1" ;;
  esac
}

# Strict refreshes validate three complete four-partition runs against the
# actual lane inventory. Legacy ingestion without --output stays compatible.
validate_lane_timings() {
  local tsvs="$1" lane="$2" rows="$3" metadata="$4" inventory="$5"
  local f header run partition parent
  enumerate_test_files | while IFS= read -r f; do
    if [ "$lane" = current ] || ! grep -qE "$REPO_CONTRACT_TAG_RE" "$f"; then
      printf '%s\n' "$f"
    fi
  done >"$inventory"
  [ -s "$inventory" ] || die "empty lane inventory"
  while IFS= read -r f; do
    header="$(head -n 1 "$f")"
    # Headers carry exactly the formatter schema, not inferred artifact names.
    printf '%s\n' "$header" | grep -Eq "^# threadline.partition-timings/1 partition=[1-4] lane=$lane boot_ms=[0-9]+ wall_ms=[0-9]+$" ||
      die "invalid or wrong-lane timing header: $f"
    partition="$(printf '%s\n' "$header" | sed -E 's/.* partition=([1-4]) .*/\1/')"
    parent="$(dirname "$f")"
    [ "$(basename "$parent")" = "$lane" ] || die "expected <run>/$lane/ timing directory: $f"
    run="$(basename "$(dirname "$parent")")"
    case "$run" in ''|*[!0-9]*) die "invalid timing run directory: $run" ;; esac
    printf '%s\t%s\n' "$run" "$partition" >>"$metadata"
    awk -F'\t' -v run="$run" '
      NR == 1 {next}
      NF != 3 || $1 !~ /^test\/[^[:space:]]+_test\.exs$/ || $2 !~ /^[0-9]+$/ || $3 !~ /^[0-9]+$/ {
        print "malformed timing row: " FILENAME ":" FNR > "/dev/stderr"; bad=1; next
      }
      { print run "\t" $1 "\t" $2 }
      END {exit bad}
    ' "$f" >>"$rows" || die "invalid timing rows"
  done <"$tsvs"
  awk -F'\t' '
    {runs[$1]=1; key=$1 SUBSEP $2; if (seen[key]++) bad=1; counts[$1]++}
    END {
      for (r in runs) {n++; if(counts[r]!=4) bad=1; for(p=1;p<=4;p++) if(!seen[r SUBSEP p]) bad=1}
      if(n!=3 || bad) {print "expected exactly three distinct runs with partitions 1..4" > "/dev/stderr"; exit 1}
    }
  ' "$metadata" || die "incomplete or duplicate timing partitions"
  awk -F'\t' -v inv="$inventory" -v meta="$metadata" '
    FILENAME==inv {expected[$1]=1; next}
    FILENAME==meta {runs[$1]=1; next}
    {key=$1 SUBSEP $2; if(!($2 in expected) || seen[key]++) bad=1}
    END {
      for(r in runs) for(f in expected) if(!seen[r SUBSEP f]) bad=1
      if(bad) {print "lane timing inventory missing, duplicate or stale" > "/dev/stderr"; exit 1}
    }
  ' "$inventory" "$metadata" "$rows" || die "invalid lane timing inventory"
}

# Prints `<partition>\t<file>\t<effective weight>` for every enumerated file.
# Args: N, weights file (may be missing), enumerated file list.
assign_files() {
  local n="$1" weights="$2" enumerated="$3" colocate="${4:-$COLOCATE_REL}"
  local f flags

  [ -f "$weights" ] || weights=/dev/null
  [ -f "$colocate" ] || colocate=/dev/null

  flags="$(mktemp "${TMPDIR:-/tmp}/ci-test-partitions-flags.XXXXXX")"
  while IFS= read -r f; do
    if grep -qE '^[[:space:]]*use [A-Za-z0-9_.]+,.*async:[[:space:]]*true' "$f"; then
      printf '%s\t1\n' "$f"
    else
      printf '%s\t0\n' "$f"
    fi
  done <"$enumerated" >"$flags"

  awk -F'\t' -v wf="$weights" -v async_factor_permille="$ASYNC_FACTOR_PERMILLE" '
    FILENAME == wf {
      if ($0 ~ /^[ \t]*#/ || $0 ~ /^[ \t]*$/) next
      c = split($0, p, /[ \t]+/)
      if (c >= 2 && p[1] ~ /^[0-9]+$/) w[p[2]] += p[1]
      next
    }
    { k++; path[k] = $1; async[k] = $2 }
    END {
      m = 0
      for (i = 1; i <= k; i++) if (path[i] in w) vals[++m] = w[path[i]] + 0
      for (i = 2; i <= m; i++) {
        v = vals[i]; j = i - 1
        while (j >= 1 && vals[j] > v) { vals[j + 1] = vals[j]; j-- }
        vals[j + 1] = v
      }
      if (m == 0) med = 1000
      else if (m % 2 == 1) med = vals[(m + 1) / 2]
      else med = int((vals[m / 2] + vals[m / 2 + 1]) / 2)
      for (i = 1; i <= k; i++) {
        raw = (path[i] in w) ? w[path[i]] : med
        eff = (async[i] == 1) ? int(raw * async_factor_permille / 1000) : raw
        if (eff < 1) eff = 1
        printf "%d\t%s\n", eff, path[i]
      }
    }
  ' "$weights" "$flags" |
    awk -F'\t' -v n="$n" -v cf="$colocate" '
      # Colocation groups: every file on one non-comment line of the colocate
      # file shares a partition (tests that touch the shared checkout, which
      # the old single serial run never overlapped). A group is placed as one
      # unit; listed files that no longer exist are simply never seen below.
      FILENAME == cf {
        if ($0 ~ /^[ \t]*#/ || $0 ~ /^[ \t]*$/) next
        c = split($0, p, /[ \t]+/)
        key = ""
        for (x = 1; x <= c; x++) {
          if (p[x] == "") continue
          if (key == "") key = p[x]
          group[p[x]] = key
        }
        next
      }
      {
        eff = $1 + 0; f = $2
        key = (f in group) ? group[f] : f
        if (!(key in gw)) { keys[++kn] = key }
        gw[key] += eff
        members[key] = members[key] f "\n"
        weight[f] = eff
      }
      END {
        # Heaviest group first, ties by key, so the result is deterministic.
        for (i = 2; i <= kn; i++) {
          v = keys[i]; j = i - 1
          while (j >= 1 && (gw[keys[j]] < gw[v] || (gw[keys[j]] == gw[v] && keys[j] > v))) {
            keys[j + 1] = keys[j]; j--
          }
          keys[j + 1] = v
        }
        for (b = 1; b <= n; b++) load[b] = 0
        for (i = 1; i <= kn; i++) {
          best = 1
          for (b = 2; b <= n; b++) if (load[b] < load[best]) best = b
          load[best] += gw[keys[i]]
          m = split(members[keys[i]], mem, "\n")
          for (x = 1; x <= m; x++) if (mem[x] != "") printf "%d\t%s\t%d\n", best, mem[x], weight[mem[x]]
        }
      }
    ' "$colocate" -

  rm -f "$flags"
}

# The correctness guard: every enumerated file assigned exactly once, to a
# partition from 1 to N. Args: N, enumerated file list, assignment file.
verify_assignment() {
  local n="$1" enumerated="$2" assignment="$3" dups out_of_range

  dups="$(cut -f2 "$assignment" | LC_ALL=C sort | uniq -d)"
  if [ -n "$dups" ]; then
    printf 'ci-test-partitions: these test files were assigned to more than one partition:\n%s\n' "$dups" >&2
    return 1
  fi

  out_of_range="$(awk -F'\t' -v n="$n" '!($1 ~ /^[0-9]+$/) || $1 < 1 || $1 > n' "$assignment")"
  if [ -n "$out_of_range" ]; then
    printf 'ci-test-partitions: these assignments name a partition outside 1-%s:\n%s\n' "$n" "$out_of_range" >&2
    return 1
  fi

  if ! cut -f2 "$assignment" | LC_ALL=C sort | cmp -s - "$enumerated"; then
    printf 'ci-test-partitions: the partition assignment does not cover every test file exactly once (< enumerated, > assigned):\n' >&2
    cut -f2 "$assignment" | LC_ALL=C sort | diff "$enumerated" - >&2 || true
    return 1
  fi
}

# --- ExUnit counts parsing ----------------------------------------------------

parse_counts() {
  local log="$1" line tests failures
  # ExUnit may colour its summary line; strip ANSI escapes before matching so a
  # coloured "N tests, M failures" still parses on every Elixir version.
  line="$(sed 's/\x1b\[[0-9;]*m//g' "$log" 2>/dev/null | grep -E '[0-9]+ tests?, [0-9]+ failures?' | tail -1 || true)"

  if [ -z "$line" ]; then
    # Newer ExUnit (1.19+) summarises as "Result: 1169 passed, 1 excluded" or
    # "Result: 697/698 passed (2/2 properties, 695/696 tests)" plus a
    # "Failed: 1 test" line.
    local result failed
    result="$(sed 's/\x1b\[[0-9;]*m//g' "$log" 2>/dev/null | grep -E '^Result: ' | tail -1 || true)"
    if [ -n "$result" ]; then
      failed="$(sed 's/\x1b\[[0-9;]*m//g' "$log" 2>/dev/null | grep -oE '^Failed: [0-9]+' | tail -1 | grep -oE '[0-9]+' || true)"
      tests="$(printf '%s' "$result" | grep -oE '[0-9]+/[0-9]+ tests' | grep -oE '/[0-9]+' | tr -d '/' || true)"
      if [ -z "$tests" ]; then
        tests="$(printf '%s' "$result" | grep -oE '[0-9]+ tests' | grep -oE '[0-9]+' || true)"
      fi
      if [ -z "$tests" ]; then
        tests="$(printf '%s' "$result" | grep -oE '[0-9]+(/[0-9]+)? passed' | grep -oE '[0-9]+' | tail -1 || true)"
      fi
      printf '%s tests, %s failures' "${tests:-0}" "${failed:-0}"
      return 0
    fi
    printf 'no tests'
    return 0
  fi

  tests="$(printf '%s' "$line" | grep -oE '[0-9]+ tests?' | tail -1 | grep -oE '[0-9]+')"
  failures="$(printf '%s' "$line" | grep -oE '[0-9]+ failures?' | tail -1 | grep -oE '[0-9]+')"
  printf '%s tests, %s failures' "${tests:-0}" "${failures:-0}"
}

# --- Report ------------------------------------------------------------------

report() {
  local n="$1" log_dir="$2" step_seconds="$3"
  local i status start end seconds counts body hung ratio_secs ratio

  body=""
  hung=""
  ratio_secs=""
  for i in $(seq 1 "$n"); do
    status="$(grep -oE 'status=[0-9-]+' "$log_dir/partition-$i.status" 2>/dev/null | cut -d= -f2 || true)"
    start="$(grep -oE 'start=[0-9]+' "$log_dir/partition-$i.status" 2>/dev/null | cut -d= -f2 || true)"
    end="$(grep -oE 'end=[0-9]+' "$log_dir/partition-$i.status" 2>/dev/null | cut -d= -f2 || true)"

    if [ -n "$start" ] && [ -n "$end" ]; then
      seconds=$((end - start))
    else
      seconds="unknown"
    fi

    counts="$(parse_counts "$log_dir/partition-$i.log")"
    if [ "$counts" = "no tests" ] && [ -s "$log_dir/partition-$i.files" ] && [ -s "$log_dir/partition-$i.log" ]; then
      # Stdout only, never the step summary: show what the log ends with so an
      # unrecognised ExUnit summary format is visible instead of silent.
      printf 'ci-test-partitions: partition %s: no test count found; last log lines:\n' "$i"
      tail -n 5 "$log_dir/partition-$i.log" | sed 's/^/  | /'
    fi
    body="${body}| ${i} | ${status:-unknown} | ${seconds} | ${counts} |
"
    case "$seconds" in
      '' | *[!0-9]*) ;;
      *) [ ! -s "$log_dir/partition-$i.files" ] || ratio_secs="$ratio_secs $seconds" ;;
    esac
    if [ -f "$log_dir/partition-$i.budget" ]; then
      hung="${hung}$(hung_rows "$i" "$log_dir/partition-$i.log")
"
    fi
  done

  # Slowest over fastest partition, over partitions with at least one file
  # and a known time; n/a when there is none or the fastest took 0 s.
  ratio="$(printf '%s\n' $ratio_secs | awk '
    NF { v = $1 + 0; if (n == 0 || v < lo) lo = v; if (n == 0 || v > hi) hi = v; n++ }
    END { if (n == 0 || lo <= 0) print "n/a"; else printf "%.2f\n", hi / lo }
  ')"

  {
    printf 'ci-test-partitions: partition report (N=%s)\n\n' "$n"
    printf '| Partition | Exit | Seconds | Counts |\n'
    printf '|---|---|---|---|\n'
    printf '%s' "$body"
    printf '| total | - | %s | - |\n' "$step_seconds"
    printf '| max/min | - | %s | - |\n' "$ratio"
    if [ -n "$hung" ]; then
      printf '\nHung partitions (killed at the %ss budget; stacks are in the partition log):\n\n' \
        "${CI_TEST_PARTITIONS_BUDGET_S:-480}"
      printf '| Partition | In flight |\n'
      printf '|---|---|\n'
      printf '%s' "$hung"
    fi
  } | tee -a "${GITHUB_STEP_SUMMARY:-/dev/null}"

  # D-12: visible every run, never a gate. Stdout only, so the step summary
  # never shows it as a failure, and the exit status is unchanged.
  if [ "$ratio" != "n/a" ] && awk -v r="$ratio" 'BEGIN { exit !(r + 0 > 1.15) }'; then
    printf '::warning::partition ratio %s exceeds 1.15\n' "$ratio"
  fi
}

# `| <i> | <in-flight name> |` rows for a budget-killed partition: the lines
# of the monitor's `HANG: in-flight:` block or, when there is none, ExUnit's
# `* <test> [file:line]` lines after `Aborting test suite` (both name the same
# tests after a QUIT). At most 10 rows of 100 characters, with `|` replaced,
# so the step summary never carries stacks or raw log text.
hung_rows() {
  local i="$1" log="$2" names
  names="$(sed 's/\x1b\[[0-9;]*m//g' "$log" 2>/dev/null | awk '
    /HANG: in-flight:/ { on = 1; next }
    /HANG: processes/ { on = 0; next }
    /Aborting test suite/ { ab = 1; next }
    on && /^  [^ ]/ { sub(/^  /, ""); hang[++h] = $0; next }
    ab && /^[[:space:]]*\* / { sub(/^[[:space:]]*\* /, ""); abort[++a] = $0 }
    END {
      if (h > 0) for (k = 1; k <= h; k++) print hang[k]
      else for (k = 1; k <= a; k++) print abort[k]
    }
  ' | awk '!seen[$0]++' | head -n 10 | cut -c1-100 | tr '|' '/' || true)"
  if [ -z "$names" ]; then
    printf '| %s | (no in-VM report; see the partition log) |' "$i"
  else
    printf '%s\n' "$names" | awk -v i="$i" 'NR > 1 { printf "\n" } { printf "| %s | %s |", i, $0 }'
  fi
}

print_failing_logs() {
  local n="$1" log_dir="$2" i status

  for i in $(seq 1 "$n"); do
    status="$(grep -oE 'status=[0-9-]+' "$log_dir/partition-$i.status" 2>/dev/null | cut -d= -f2 || true)"

    if [ -n "$status" ] && [ "$status" != "0" ]; then
      printf '===== partition %s failed (exit %s) =====\n' "$i" "$status"
      cat "$log_dir/partition-$i.log" 2>/dev/null || true
      printf '===== end partition %s =====\n' "$i"
    fi
  done
}

# --- Budget watchdog (D-14) -----------------------------------------------------

# A non-negative integer of seconds from a test-only seam, or exit 2.
seconds_env() {
  local name="$1" default="$2" value
  eval "value=\"\${$name:-$default}\""
  case "$value" in
    '' | *[!0-9]*) die "$name must be a non-negative integer of seconds, got '$value'" ;;
  esac
  printf '%s' "$value"
}

# Prints `<pid> <start time>` for every live process in process group $1 and
# every descendant of those, from one `ps` snapshot. Children that started a
# new session left the group but are still found by descent while their
# parent lives. The start time lets a later KILL skip a reused PID.
partition_tree() {
  local pgid="$1" pid_list
  pid_list="$(ps -A -o pid=,ppid=,pgid= 2>/dev/null | awk -v g="$pgid" '
    { pid[NR] = $1; ppid[NR] = $2; if ($3 == g) keep[$1] = 1 }
    END {
      do {
        added = 0
        for (k = 1; k <= NR; k++) if (!(pid[k] in keep) && (ppid[k] in keep)) { keep[pid[k]] = 1; added = 1 }
      } while (added)
      for (p in keep) print p
    }
  ' | LC_ALL=C sort -n | tr '\n' ',' | sed 's/,$//' || true)"
  [ -n "$pid_list" ] || return 0
  ps -o pid=,lstart= -p "$pid_list" 2>/dev/null || true
}

# The backstop when no in-VM report arrived: last log lines, the partition's
# process tree and its database sessions. Stdout only.
partition_backstop() {
  local i="$1" pgid="$2" log="$3" tree="$4" psql_bin pids
  psql_bin="${CI_TEST_PARTITIONS_PSQL:-psql}"

  printf 'ci-test-partitions: partition %s: no in-VM report; backstop diagnostics follow\n' "$i"
  printf -- '----- partition %s: last 40 log lines -----\n' "$i"
  tail -n 40 "$log" 2>/dev/null | sed 's/^/  | /' || true
  printf -- '----- partition %s: process tree (ps -A -o pid,ppid,etime,args) -----\n' "$i"
  pids="$(awk '{ printf "%s ", $1 }' "$tree" 2>/dev/null || true)"
  ps -A -ww -o pid,ppid,etime,args 2>/dev/null | awk -v keep="$pids" '
    BEGIN { n = split(keep, k, " "); for (j = 1; j <= n; j++) want[k[j]] = 1 }
    NR == 1 || ($1 in want) { print "  " substr($0, 1, 200) }
  ' || true
  printf -- '----- partition %s: pg_stat_activity for threadline_test%s -----\n' "$i" "$i"
  if command -v "$psql_bin" >/dev/null 2>&1; then
    PGPASSWORD="${PGPASSWORD:-postgres}" PGCONNECT_TIMEOUT=5 "$psql_bin" -X -A \
      -h "${DB_HOST:-localhost}" -p "${DB_PORT:-5432}" -U postgres -d postgres \
      -c "SET statement_timeout = 5000" \
      -c "SELECT pid, state, wait_event_type, wait_event, now() - query_start AS age, left(query, 200) AS query FROM pg_stat_activity WHERE datname = 'threadline_test$i' ORDER BY query_start" \
      2>&1 </dev/null | sed 's/^/  | /' || true
  else
    printf '  (psql not found)\n'
  fi
}

# Diagnose, then stop a partition that exceeded its budget. $2 is the
# partition subshell's PID, which is also its process group id.
stop_over_budget() {
  local i="$1" pgid="$2" log_dir="$3" budget_s="$4" diag_wait_s="$5" kill_grace_s="$6"
  local log="$log_dir/partition-$i.log" tree="$log_dir/partition-$i.tree"
  local beam waited p lstart now_lstart line marker

  # Written first, so the partition's own status writer never overwrites the
  # budget record and an exit during diagnosis still counts as a failure.
  : >"$log_dir/partition-$i.budget"
  marker="ci-test-partitions: partition $i exceeded budget ${budget_s}s"
  printf '%s\n' "$marker"

  if ! grep -q 'HANG: in-flight:' "$log" 2>/dev/null; then
    beam="$(cat "$log_dir/partition-$i.beam.pid" 2>/dev/null || true)"
    if [ -n "$beam" ] && kill -0 "$beam" 2>/dev/null; then
      printf 'ci-test-partitions: partition %s: sending QUIT to its BEAM (pid %s) for the in-flight report\n' "$i" "$beam"
      kill -QUIT "$beam" 2>/dev/null || true
    fi
    waited=0
    while [ "$waited" -lt "$diag_wait_s" ]; do
      grep -qE 'HANG: in-flight:|Aborting test suite' "$log" 2>/dev/null && break
      kill -0 -- -"$pgid" 2>/dev/null || break
      sleep 1
      waited=$((waited + 1))
    done
  fi

  partition_tree "$pgid" >"$tree"
  if ! grep -qE 'HANG: in-flight:|Aborting test suite' "$log" 2>/dev/null; then
    partition_backstop "$i" "$pgid" "$log" "$tree"
  fi

  kill -TERM -- -"$pgid" 2>/dev/null || true
  waited=0
  while [ "$waited" -lt "$kill_grace_s" ] && kill -0 -- -"$pgid" 2>/dev/null; do
    sleep 1
    waited=$((waited + 1))
  done
  if kill -0 -- -"$pgid" 2>/dev/null; then
    printf 'ci-test-partitions: partition %s ignored SIGTERM for %ss; sending SIGKILL to its process group\n' "$i" "$kill_grace_s"
  fi
  kill -KILL -- -"$pgid" 2>/dev/null || true
  # Descendants that left the group: KILL only a PID whose start time still
  # matches the snapshot, never a reused one.
  while IFS= read -r line; do
    p="${line%% *}"
    p="${p## }"
    lstart="$(printf '%s' "$line" | sed 's/^ *[0-9][0-9]* *//')"
    [ -n "$p" ] || continue
    now_lstart="$(ps -o lstart= -p "$p" 2>/dev/null | sed 's/^ *//' || true)"
    if [ -n "$now_lstart" ] && [ "$now_lstart" = "$lstart" ]; then
      kill -KILL "$p" 2>/dev/null || true
    fi
  done < <(sed 's/^ *//' "$tree")

  printf 'status=124 reason=budget start=%s end=%s\n' "${starts[i]}" "$(date +%s)" \
    >"$log_dir/partition-$i.status"
  printf '%s; killed (status=124 reason=budget)\n' "$marker" >>"$log"
}

# Polls every partition until each has exited or has been stopped at its
# budget. Never blocks on `wait`, so a hung partition cannot stall the poll.
# Reads `pids` and `starts` from run_partitions; sets WATCHDOG_KILLED=1 when
# it stopped any partition.
watch_partitions() {
  local n="$1" log_dir="$2"
  local budget_s="${CI_TEST_PARTITIONS_BUDGET_S:-480}"
  local diag_wait_s kill_grace_s
  diag_wait_s="$(seconds_env CI_TEST_PARTITIONS_DIAG_WAIT_S 30)"
  kill_grace_s="$(seconds_env CI_TEST_PARTITIONS_KILL_GRACE_S 10)"
  local i pid now alive poll=0
  local finished=()

  while :; do
    alive=0
    now="$(date +%s)"
    for i in $(seq 1 "$n"); do
      [ -z "${finished[i]:-}" ] || continue
      pid="${pids[i]}"
      if ! kill -0 "$pid" 2>/dev/null; then
        finished[i]=1
        continue
      fi
      if [ $((now - starts[i])) -gt "$budget_s" ]; then
        WATCHDOG_KILLED=1
        stop_over_budget "$i" "$pid" "$log_dir" "$budget_s" "$diag_wait_s" "$kill_grace_s"
        finished[i]=1
        continue
      fi
      alive=1
    done
    [ "$alive" -eq 1 ] || break
    # Short first polls keep fast runs fast; then once a second.
    case "$poll" in
      0) sleep 0.1 ;;
      1) sleep 0.3 ;;
      *) sleep 1 ;;
    esac
    poll=$((poll + 1))
  done
}

# --- Run N partitions ----------------------------------------------------------

run_partitions() {
  local n="$1"
  local log_dir="${CI_TEST_PARTITIONS_LOG_DIR:-$ROOT/tmp/ci-test-partitions}"
  local budget_s="${CI_TEST_PARTITIONS_BUDGET_S:-480}"

  local test_scope="${THREADLINE_TEST_SCOPE:-}"
  local selected_weights
  selected_weights="$(lane_weights "${THREADLINE_CI_LANE:-}")"

  case "$budget_s" in
    '' | *[!0-9]* | 0*) die "CI_TEST_PARTITIONS_BUDGET_S must be a positive integer of seconds, got '$budget_s'" ;;
  esac
  case "$test_scope" in
    '' | toolchain) ;;
    *)
      usage >&2
      die "THREADLINE_TEST_SCOPE must be empty or 'toolchain', got '$test_scope'"
      ;;
  esac
  # Fail fast on a bad watchdog seam, before anything runs.
  seconds_env CI_TEST_PARTITIONS_DIAG_WAIT_S 30 >/dev/null
  seconds_env CI_TEST_PARTITIONS_KILL_GRACE_S 10 >/dev/null
  # The monitor's in-VM deadline leaves 30 s of the budget for its stack dump
  # and halt; a budget of 30 s or less disarms it (the value is not positive).
  local deadline_ms=$((budget_s * 1000 - 30000))
  # Appended after the assigned files on every partition's `mix test`: the
  # CLI formatter keeps the normal output, the monitor adds timings and the
  # hang report. Only this script attaches the monitor.
  local monitor_args=(--formatter ExUnit.CLIFormatter --formatter Threadline.Test.PartitionMonitor)

  cd "$ROOT"
  rm -rf "$log_dir"
  mkdir -p "$log_dir"

  export MIX_ENV=test

  local step_start step_end step_seconds
  step_start="$(date +%s)"

  local enumerated="$log_dir/enumerated.txt"
  local assignment="$log_dir/assignment.tsv"
  enumerate_test_files >"$enumerated"
  [ -s "$enumerated" ] || die "found no *_test.exs files under test/"
  cp "$enumerated" "$log_dir/enumerated.full.txt"

  # D-10 lane scope: on `toolchain` lanes, drop the repo-contract files from
  # the set; every later step (assignment, exactly-once check) uses it.
  if [ "$test_scope" = toolchain ]; then
    local scoped_out="$log_dir/repo-contract.txt" kept="$log_dir/enumerated.kept.txt" f
    : >"$scoped_out"
    : >"$kept"
    while IFS= read -r f; do
      if grep -qE "$REPO_CONTRACT_TAG_RE" "$f"; then
        printf '%s\n' "$f" >>"$scoped_out"
      else
        printf '%s\n' "$f" >>"$kept"
      fi
    done <"$log_dir/enumerated.full.txt"
    mv "$kept" "$enumerated"
    [ -s "$enumerated" ] || die "THREADLINE_TEST_SCOPE=toolchain left no test files to run"
    printf 'ci-test-partitions: %s repo-contract files run on the current lane only\n' \
      "$(wc -l <"$scoped_out" | tr -d ' ')" | tee -a "${GITHUB_STEP_SUMMARY:-/dev/null}"
    [ -z "${GITHUB_STEP_SUMMARY:-}" ] || printf '\n' >>"$GITHUB_STEP_SUMMARY"
  fi

  case "${THREADLINE_CI_LANE:-}" in
    min|latest) [ -f "$selected_weights" ] || die "lane weights missing: $selected_weights" ;;
  esac
  if [ ! -f "$selected_weights" ]; then
    printf 'ci-test-partitions: %s is missing; every file gets the same weight (run bin/ci-test-partitions --write-weights)\n' "$selected_weights" >&2
  fi

  assign_files "$n" "$selected_weights" "$enumerated" >"$assignment"
  verify_assignment "$n" "$enumerated" "$assignment" || {
    printf 'ci-test-partitions: refusing to run an assignment that would skip or repeat tests\n' >&2
    exit 1
  }

  local i
  printf 'ci-test-partitions: %s test files assigned to %s partitions by measured weight (%s)\n' \
    "$(wc -l <"$enumerated" | tr -d ' ')" "$n" "$selected_weights"
  for i in $(seq 1 "$n"); do
    awk -F'\t' -v i="$i" '$1 == i { print $2 }' "$assignment" >"$log_dir/partition-$i.files"
    printf 'ci-test-partitions: partition %s: %s files, weight %s ms\n' "$i" \
      "$(wc -l <"$log_dir/partition-$i.files" | tr -d ' ')" \
      "$(awk -F'\t' -v i="$i" '$1 == i { s += $3 } END { print s + 0 }' "$assignment")"
  done

  printf 'ci-test-partitions: compiling once, serially\n'
  if ! "$MIX_BIN" compile; then
    die "serial compile failed"
  fi

  local pids=()
  local starts=()
  WATCHDOG_KILLED=0

  # Armed before the first fork, so a signal during forking still kills every
  # partition already started (an empty pids list is a no-op). Each PID is a
  # process group id (set -m below), so the whole partition tree is signalled:
  # TERM, then KILL for any group still alive after the kill grace.
  kill_all() {
    local pid waited=0 grace
    grace="$(seconds_env CI_TEST_PARTITIONS_KILL_GRACE_S 10)"
    for pid in ${pids[@]+"${pids[@]}"}; do
      kill -TERM -- -"$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
    done
    while [ "$waited" -lt "$grace" ]; do
      local any=0
      for pid in ${pids[@]+"${pids[@]}"}; do
        if kill -0 -- -"$pid" 2>/dev/null; then any=1; fi
      done
      [ "$any" -eq 1 ] || break
      sleep 1
      waited=$((waited + 1))
    done
    for pid in ${pids[@]+"${pids[@]}"}; do
      kill -KILL -- -"$pid" 2>/dev/null || true
    done
    wait 2>/dev/null || true
    printf 'ci-test-partitions: interrupted, killed every partition process\n' >&2
    exit 1
  }
  trap kill_all INT TERM

  # Job control on for the forks only: each `( ... ) &` partition then leads
  # its own process group (PGID == its PID), which the budget watchdog and
  # kill_all signal as a unit. Stdin is /dev/null, as for any background job
  # without job control.
  set -m
  for i in $(seq 1 "$n"); do
    starts[i]="$(date +%s)"
    (
      # A handler, never `trap ''` (an ignored signal is inherited by mix):
      # a group TERM interrupts the wait below instead of killing this
      # subshell, so it can still exit with a status.
      trap ':' TERM
      p_start="$(date +%s)"
      files=()
      while IFS= read -r f; do
        files+=("$f")
      done <"$log_dir/partition-$i.files"
      set +e
      if [ "${#files[@]}" -eq 0 ]; then
        # Never call mix with no files: a bare `mix test` runs the whole suite.
        printf 'ci-test-partitions: partition %s has no test files assigned\n' "$i" \
          >"$log_dir/partition-$i.log"
        p_status=0
      else
        # A per-test budget of 180 s instead of ExUnit's 60 s default: with N
        # partitions sharing the runner, nested builds and Node smokes run
        # several times slower than in a lone `mix test` (CI runs 36799589565,
        # 36800563728 and 36818463238 timed such tests out at 60 s). A plain
        # local `mix test` keeps the default.
        THREADLINE_TEST_DEADLINE_MS="$deadline_ms" \
          THREADLINE_PARTITION_TIMINGS_FILE="$log_dir/partition-timings-$i.tsv" \
          MIX_TEST_PARTITION="$i" "$MIX_BIN" test --no-compile --no-deps-check --timeout="$PARTITION_TEST_TIMEOUT_MS" "${files[@]}" ${monitor_args[@]+"${monitor_args[@]}"} \
          >"$log_dir/partition-$i.log" 2>&1 &
        # mix execs through elixir and erl, so this PID is the BEAM: the
        # watchdog sends QUIT to it alone.
        beam_pid="$!"
        printf '%s\n' "$beam_pid" >"$log_dir/partition-$i.beam.pid"
        wait "$beam_pid"
        p_status=$?
      fi
      set -e
      p_end="$(date +%s)"
      if [ -f "$log_dir/partition-$i.budget" ]; then
        # The watchdog owns this partition's status record.
        exit 124
      fi
      printf 'status=%s start=%s end=%s\n' "$p_status" "$p_start" "$p_end" \
        >"$log_dir/partition-$i.status"
      exit "$p_status"
    ) </dev/null &
    pids[i]="$!"
  done
  set +m

  watch_partitions "$n" "$log_dir"
  local fail=0
  for i in $(seq 1 "$n"); do
    wait "${pids[i]}" || fail=1
  done
  # A partition stopped at its budget is a failure even if it exited 0
  # during diagnosis.
  [ "$WATCHDOG_KILLED" -eq 0 ] || fail=1

  trap - INT TERM

  step_end="$(date +%s)"
  step_seconds=$((step_end - step_start))

  report "$n" "$log_dir" "$step_seconds"

  if [ "$fail" -ne 0 ]; then
    print_failing_logs "$n" "$log_dir"
    exit 1
  fi

  exit 0
}

# --- --write-weights -------------------------------------------------------------

# Turns `mix test --slowest-modules` output into `<ms> <file>` lines, summed
# per file and sorted by path.
parse_slowest_modules() {
  awk '
    /^Top [0-9]+ slowest/ { on = 1; next }
    !on { next }
    /^[^ ].*\([0-9.]+ms\)$/ {
      s = $0
      sub(/ms\)$/, "", s)
      sub(/.*\(/, "", s)
      pending = s + 0
      have = 1
      next
    }
    have && /^ \[.*\]$/ {
      f = $0
      sub(/^ \[/, "", f)
      sub(/\]$/, "", f)
      t[f] += pending
      have = 0
      next
    }
    { have = 0 }
    END { for (f in t) printf "%d %s\n", int(t[f] + 0.5), f }
  ' "$1" | LC_ALL=C sort -k2,2
}

# The comment block at the top of test/partition_weights.txt, shared by
# --write-weights and --ingest-weights so both write the same file shape.
weights_header() {
  printf '# Measured test time per file, in milliseconds, used by bin/ci-test-partitions\n'
  printf '# to balance the CI test partitions. One "<milliseconds> <test file>" per line,\n'
  printf '# sorted by path.\n'
  printf '# Regenerate with: bin/ci-test-partitions --write-weights\n'
  printf '# The runner tolerates stale or missing weights for assignment; every discovered test\n'
  printf '# still runs exactly once. The committed-inventory CI contract rejects either condition.\n'
}

write_weights() {
  local log_dir="${CI_TEST_PARTITIONS_LOG_DIR:-$ROOT/tmp/ci-test-partitions}"
  local log tmp status count

  cd "$ROOT"
  mkdir -p "$log_dir"
  log="$log_dir/write-weights.log"

  # CI never has a warm nested prod build, so neither may the measurement:
  # a test that shells out to `MIX_ENV=prod mix ...` is measured with the
  # prod build cold, as it runs in every CI job. A warm local _build/prod
  # once made such a test weigh a fraction of its CI cost and unbalanced the
  # partitions (CI run 36803573797).
  rm -rf "$ROOT/_build/prod"

  printf 'ci-test-partitions: running the whole suite once with `mix test --slowest-modules 1000` (traced, so slower than a normal run)\n'
  set +e
  env -u MIX_TEST_PARTITION MIX_ENV=test "$MIX_BIN" test --slowest-modules 1000 >"$log" 2>&1
  status=$?
  set -e

  if [ "$status" -ne 0 ]; then
    tail -40 "$log" >&2 || true
    printf 'ci-test-partitions: the timing run failed (exit %s); %s left unchanged (full log: %s)\n' \
      "$status" "$WEIGHTS_REL" "$log" >&2
    exit 1
  fi

  tmp="$(mktemp "$log_dir/partition-weights.XXXXXX")"
  {
    weights_header
    parse_slowest_modules "$log"
  } >"$tmp"

  count="$(grep -vc '^#' "$tmp" || true)"
  if [ "${count:-0}" -eq 0 ]; then
    rm -f "$tmp"
    printf 'ci-test-partitions: found no per-module timings in the run output; %s left unchanged (full log: %s)\n' \
      "$WEIGHTS_REL" "$log" >&2
    exit 1
  fi

  mv "$tmp" "$WEIGHTS_REL"
  printf 'ci-test-partitions: wrote %s weights to %s\n' "$count" "$WEIGHTS_REL"
}

# --- --ingest-weights ------------------------------------------------------------

# Rewrites test/partition_weights.txt from the threadline.partition-timings/1
# TSVs that Threadline.Test.PartitionMonitor writes at suite end: a header
# line `# threadline.partition-timings/1 partition=<i> lane=<lane> ...` and
# one `<file>\t<wall_ms>\t<test_ms>` row per test file. Only rows whose file
# is a `test/...*_test.exs` path and whose wall_ms is a whole number are
# read; anything else in a TSV is ignored. TSVs are selected by their header
# `lane=` field, never by path or artifact name.
# Args: <dir> [--lane <name>] [--output <committed-weight-path>].
ingest_weights() {
  local dir="${1:-}" lane="" lane_set=0 output="$WEIGHTS_REL" strict=0
  [ -n "$dir" ] || die "--ingest-weights needs a directory of partition-timings-*.tsv files"
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --lane)
        [ $# -ge 2 ] || die "--lane needs a lane name"
        lane="$2"
        lane_set=1
        shift 2
        ;;
      --output)
        [ $# -ge 2 ] || die "--output needs a committed weight path"
        output="$2"; strict=1; shift 2
        ;;
      *) die "--ingest-weights: unexpected argument '$1'" ;;
    esac
  done
  if [ "$lane_set" -eq 1 ]; then
    case "$lane" in
      [a-z]*) case "$lane" in *[!a-z0-9-]*) lane_set=bad ;; esac ;;
      *) lane_set=bad ;;
    esac
    [ "$lane_set" = 1 ] || die "--lane must match ^[a-z][a-z0-9-]*\$, got '$lane'"
  fi
  if [ "$strict" -eq 1 ]; then
    [ "$lane_set" = 1 ] || die "--output requires --lane current|min|latest"
    [ "$output" = "$(lane_weights "$lane")" ] || die "disallowed --output for lane $lane: $output"
  fi
  [ -d "$dir" ] || die "--ingest-weights: no such directory: $dir"
  dir="$(cd "$dir" && pwd -P)"

  cd "$ROOT"

  local tsvs rows moved tmp f header tsv_lane total=0 used=0 skipped=0 metadata inventory strict_rows
  tsvs="$(mktemp "${TMPDIR:-/tmp}/ci-test-partitions-tsvs.XXXXXX")"
  rows="$(mktemp "${TMPDIR:-/tmp}/ci-test-partitions-rows.XXXXXX")"
  moved="$(mktemp "${TMPDIR:-/tmp}/ci-test-partitions-moved.XXXXXX")"
  metadata="$(mktemp "${TMPDIR:-/tmp}/ci-test-partitions-meta.XXXXXX")"
  inventory="$(mktemp "${TMPDIR:-/tmp}/ci-test-partitions-inventory.XXXXXX")"
  strict_rows="$(mktemp "${TMPDIR:-/tmp}/ci-test-partitions-strict.XXXXXX")"
  tmp=""
  # shellcheck disable=SC2064 # expand now: the paths are fixed for this run
  trap "rm -f '$tsvs' '$rows' '$moved' '$metadata' '$inventory' '$strict_rows' \"\${tmp:-}\"" EXIT

  find "$dir" -type f -name 'partition-timings-*.tsv' | LC_ALL=C sort >"$tsvs"

  if [ "$strict" -eq 1 ]; then
    validate_lane_timings "$tsvs" "$lane" "$strict_rows" "$metadata" "$inventory"
  fi

  while IFS= read -r f; do
    total=$((total + 1))
    header="$(head -n 1 "$f")"
    case "$header" in
      '# threadline.partition-timings/1 '*) ;;
      *) die "--ingest-weights: $f does not start with a threadline.partition-timings/1 header" ;;
    esac
    tsv_lane="$(printf '%s\n' "$header" | awk '{ for (i = 1; i <= NF; i++) if ($i ~ /^lane=/) { sub(/^lane=/, "", $i); print $i; exit } }')"
    if [ "$lane_set" -eq 1 ] && [ "$tsv_lane" != "$lane" ]; then
      skipped=$((skipped + 1))
      continue
    fi
    used=$((used + 1))
    awk -F'\t' 'NR > 1 && NF >= 2 && $1 ~ /^test\/[A-Za-z0-9_.\/-]*_test\.exs$/ && $2 ~ /^[0-9]+$/ { printf "%s\t%d\n", $1, $2 }' "$f" >>"$rows"
  done <"$tsvs"

  [ "$total" -gt 0 ] || die "--ingest-weights: found no partition-timings-*.tsv under $dir"
  if [ "$used" -eq 0 ]; then
    die "--ingest-weights: none of the $total TSVs under $dir has lane=$lane"
  fi

  tmp="$(mktemp "$(dirname "$output")/.partition_weights.XXXXXX")"
  {
    weights_header
    # Median per file: rows sorted by file, then by wall_ms; the middle value
    # of an odd count, the lower middle of an even one. Merged with the old
    # weights (files absent from the TSVs keep theirs) and sorted by path.
    LC_ALL=C sort -t "$(printf '\t')" -k1,1 -k2,2n "$rows" |
      awk -F'\t' '
        function flush() { if (c > 0) printf "%d %s\n", (v[int((c + 1) / 2)] < 1 ? 1 : v[int((c + 1) / 2)]), key }
        $1 != key { flush(); key = $1; c = 0 }
        { v[++c] = $2 + 0 }
        END { flush() }
      ' |
      awk -v wf="$output" -v mf="$moved" -v strict="$strict" '
        BEGIN {
          while ((getline line < wf) > 0) {
            if (line ~ /^[ \t]*#/ || line ~ /^[ \t]*$/) continue
            c = split(line, p, /[ \t]+/)
            if (c >= 2 && p[1] ~ /^[0-9]+$/) old[p[2]] = p[1] + 0
          }
        }
        { new[$2] = $1 + 0 }
        END {
          for (f in old) if (!strict && !(f in new)) printf "%d %s\n", old[f], f
          for (f in new) {
            printf "%d %s\n", new[f], f
            if ((f in old) && (new[f] > 2 * old[f] || old[f] > 2 * new[f]))
              printf "moved >2x: %d -> %d %s\n", old[f], new[f], f > mf
          }
        }
      ' |
      LC_ALL=C sort -k2,2
  } >"$tmp"

  mv "$tmp" "$output"
  tmp=""
  printf 'ingest-weights: %s files from %s TSVs (%s skipped by --lane)\n' \
    "$(cut -f1 "$rows" | LC_ALL=C sort -u | wc -l | tr -d ' ')" "$used" "$skipped"
  LC_ALL=C sort -k6,6 "$moved"
}

# --- Fake mix for --self-test -------------------------------------------------

write_fake_mix() {
  local path="$1"
  cat >"$path" <<'FAKE_MIX'
#!/usr/bin/env bash
# Test-only fake `mix` for bin/ci-test-partitions --self-test. Never used by
# real callers.
set -u

case "${1:-}" in
  compile)
    exit 0
    ;;
  test)
    shift

    case " $* " in
      *" --slowest-modules "*)
        echo "Finished in 1.5 seconds (0.0s async, 1.5s sync)"
        echo ""
        echo "Top 3 slowest (1.5s), 100.0% of total time:"
        echo ""
        echo "Fake.OneTest (1500.4ms)"
        echo " [test/one_test.exs]"
        echo "Fake.TwoTest (10.2ms)"
        echo " [test/a/two_test.exs]"
        echo "Fake.TwoOtherTest (5.0ms)"
        echo " [test/a/two_test.exs]"
        echo ""
        echo "3 tests, 0 failures"
        exit 0
        ;;
    esac

    has_no_compile=0
    has_no_deps_check=0
    files=()
    formatters=()
    want_formatter=0
    for a in "$@"; do
      if [ "$want_formatter" -eq 1 ]; then
        formatters+=("$a")
        want_formatter=0
        continue
      fi
      case "$a" in
        --formatter) want_formatter=1 ;;
        --partitions)
          echo "fake-mix: --partitions must not be passed (files are assigned by weight)" >&2
          exit 3
          ;;
        --no-compile) has_no_compile=1 ;;
        --no-deps-check) has_no_deps_check=1 ;;
        --timeout=*) ;;
        -*)
          echo "fake-mix: unexpected flag $a" >&2
          exit 3
          ;;
        *) files+=("$a") ;;
      esac
    done
    if [ "$want_formatter" -eq 1 ]; then
      echo "fake-mix: --formatter needs a value" >&2
      exit 3
    fi
    if [ "$has_no_compile" -ne 1 ] || [ "$has_no_deps_check" -ne 1 ]; then
      echo "fake-mix: missing a required flag (got: $*)" >&2
      exit 3
    fi
    if [ "${#files[@]}" -eq 0 ]; then
      echo "fake-mix: called with no test files (a bare mix test runs the whole suite)" >&2
      exit 3
    fi
    for f in "${files[@]}"; do
      if [ ! -f "$f" ]; then
        echo "fake-mix: no such test file: $f" >&2
        exit 3
      fi
      echo "FAKE_MIX_FILE=$f"
    done

    for f in ${formatters[@]+"${formatters[@]}"}; do
      echo "FAKE_MIX_FORMATTER=$f"
    done
    echo "FAKE_MIX_DEADLINE_MS=${THREADLINE_TEST_DEADLINE_MS:-unset}"
    echo "FAKE_MIX_TIMINGS_FILE=${THREADLINE_PARTITION_TIMINGS_FILE:-unset}"

    idx="${MIX_TEST_PARTITION:-0}"
    echo "FAKE_MIX_PARTITION_MARKER=$idx"

    plan="${CI_TEST_PARTITIONS_FAKE_PLAN:-}"
    behavior="$(printf '%s' "$plan" | cut -d, -f"$idx")"

    case "$behavior" in
      fail)
        echo "Finished in 0.1 seconds (0.0s async, 0.1s sync)"
        echo "1 test, 1 failure"
        exit 1
        ;;
      empty)
        echo "Finished in 0.0 seconds (0.0s async, 0.0s sync)"
        echo "0 tests, 0 failures"
        exit 0
        ;;
      killed)
        kill -KILL $$
        ;;
      hang)
        # A VM that cannot report: QUIT is ignored, TERM still kills it. The
        # argv token lets the self-test prove no process is left behind.
        trap '' QUIT
        exec bash -c 'while :; do sleep 1; done' 247hangsentinel
        ;;
      hang_ignore_term)
        # Ignores QUIT and TERM, so only the group KILL stops it.
        trap '' QUIT TERM
        exec bash -c 'while :; do sleep 1; done' 247hangsentinel
        ;;
      hang_quit)
        # Answers QUIT like ExUnit's own trap: names the unfinished tests and
        # exits non-zero. Perl, because a background command starts with
        # QUIT ignored and bash cannot trap a signal ignored on entry (the
        # BEAM, like perl, installs its own handler).
        exec perl -e '$| = 1; $SIG{QUIT} = sub { print "Aborting test suite, the following have not completed:\n\n* test waits on a lock forever [test/a/heavy1_test.exs:7]\n* Sandbox.SetupAllTest [test/b/heavy3_test.exs]\n"; exit 1 }; sleep 1 while 1'
        ;;
      *)
        echo "Finished in 0.1 seconds (0.0s async, 0.1s sync)"
        echo "1 test, 0 failures"
        exit 0
        ;;
    esac
    ;;
  *)
    exit 0
    ;;
esac
FAKE_MIX
  chmod +x "$path"
}

# A throwaway project: a copy of this script under bin/, a small test/ tree
# and a weights file with three heavy files, an async file, an unweighted
# file and a stale entry for a file that does not exist.
write_sandbox_project() {
  local proj="$1"

  mkdir -p "$proj/bin" "$proj/test/a" "$proj/test/b" "$proj/test/.hidden"
  cp "$SCRIPT_PATH" "$proj/bin/ci-test-partitions"
  chmod +x "$proj/bin/ci-test-partitions"

  local f
  for f in a/heavy1_test.exs a/heavy2_test.exs b/heavy3_test.exs a/light1_test.exs \
    b/light2_test.exs b/async_test.exs b/unweighted_test.exs; do
    printf 'defmodule Sandbox.Test do\n  use ExUnit.Case\nend\n' >"$proj/test/$f"
  done
  printf 'defmodule Sandbox.AsyncTest do\n  use ExUnit.Case, async: true\nend\n' >"$proj/test/b/async_test.exs"
  printf 'not a test file\n' >"$proj/test/b/helper.exs"
  printf 'defmodule Hidden.Test do\nend\n' >"$proj/test/.hidden/skipped_test.exs"

  cat >"$proj/test/partition_weights.txt" <<'WEIGHTS'
# sandbox weights
50000 test/a/heavy1_test.exs
40000 test/a/heavy2_test.exs
1000 test/a/light1_test.exs
40000 test/b/async_test.exs
30000 test/b/heavy3_test.exs
2000 test/b/light2_test.exs
999999 test/gone_test.exs
WEIGHTS
}

# --- --self-test ---------------------------------------------------------------

run_self_test() {
  # Hermetic: an outer lane scope must not leak into the full-scope cases.
  unset THREADLINE_TEST_SCOPE THREADLINE_CI_LANE
  mkdir -p "$ROOT/tmp"
  self_test_dir="$(mktemp -d "$ROOT/tmp/ci-test-partitions-self-test.XXXXXX")"
  cleanup_self_test() {
    rm -rf "$self_test_dir"
  }
  trap cleanup_self_test EXIT

  local fake_mix="$self_test_dir/fake-mix"
  write_fake_mix "$fake_mix"

  local proj="$self_test_dir/proj"
  write_sandbox_project "$proj"
  local sandbox_script="$proj/bin/ci-test-partitions"
  local expected_files="$self_test_dir/expected-files.txt"
  (cd "$proj" && enumerate_test_files) >"$expected_files"
  [ "$(wc -l <"$expected_files" | tr -d ' ')" -eq 7 ] ||
    die "self-test: the sandbox must enumerate exactly 7 test files, got: $(cat "$expected_files")"

  local case_n=0

  # run_case <label> <fake plan> [N]
  run_case() {
    case_n=$((case_n + 1))
    case_dir="$self_test_dir/case-$case_n"
    mkdir -p "$case_dir"

    set +e
    output="$(
      MIX_BIN="$fake_mix" \
        CI_TEST_PARTITIONS_FAKE_PLAN="$2" \
        CI_TEST_PARTITIONS_LOG_DIR="$case_dir/logs" \
        GITHUB_STEP_SUMMARY="$case_dir/summary.md" \
        "$sandbox_script" "${3:-3}" 2>&1
    )"
    status=$?
    set -e

    printf '%s' "$output" >"$case_dir/output.log"
    case_status="$status"
    case_summary="$case_dir/summary.md"
    case_logs="$case_dir/logs"
  }

  # (a) all pass
  run_case "all pass" "pass,pass,pass"
  [ "$case_status" -eq 0 ] ||
    die "self-test: all-pass case must exit 0, got $case_status: $output"
  local all_pass_logs="$case_logs"

  # (b) partition 2 fails
  run_case "partition 2 fails" "pass,fail,pass"
  [ "$case_status" -ne 0 ] ||
    die "self-test: partition-2-fails case must exit non-zero"
  grep -q 'partition 2 failed' <<<"$output" ||
    die "self-test: partition-2-fails case must print partition 2's log: $output"
  grep -q 'partition 1 failed' <<<"$output" &&
    die "self-test: partition-2-fails case must not print partition 1's log"
  grep -q 'partition 3 failed' <<<"$output" &&
    die "self-test: partition-2-fails case must not print partition 3's log"

  # (c) partitions 1 and 3 fail, printed in ascending order
  run_case "partitions 1 and 3 fail" "fail,pass,fail"
  [ "$case_status" -ne 0 ] ||
    die "self-test: partitions-1-and-3-fail case must exit non-zero"
  pos1="$(printf '%s' "$output" | grep -bo 'partition 1 failed' | head -1 | cut -d: -f1)"
  pos3="$(printf '%s' "$output" | grep -bo 'partition 3 failed' | head -1 | cut -d: -f1)"
  [ -n "$pos1" ] && [ -n "$pos3" ] && [ "$pos1" -lt "$pos3" ] ||
    die "self-test: partition 1's log must print before partition 3's"

  # (d) partition 1 empty, partition 2 fails
  run_case "partition 1 empty plus partition 2 failing" "empty,fail,pass"
  [ "$case_status" -ne 0 ] ||
    die "self-test: empty-plus-failing case must exit non-zero"

  # (e) partition 1 empty, rest pass
  run_case "partition 1 empty with the rest passing" "empty,pass,pass"
  [ "$case_status" -eq 0 ] ||
    die "self-test: empty-partition-only case must exit 0, got $case_status: $output"

  # (f) a killed partition
  run_case "a killed partition" "pass,killed,pass"
  [ "$case_status" -ne 0 ] ||
    die "self-test: killed-partition case must exit non-zero"

  # (g) the summary file lists partitions in ascending order
  [ -f "$case_summary" ] || die "self-test: expected a step summary file at $case_summary"
  s_pos1="$(grep -n '^| 1 |' "$case_summary" | head -1 | cut -d: -f1)"
  s_pos2="$(grep -n '^| 2 |' "$case_summary" | head -1 | cut -d: -f1)"
  s_pos3="$(grep -n '^| 3 |' "$case_summary" | head -1 | cut -d: -f1)"
  [ -n "$s_pos1" ] && [ -n "$s_pos2" ] && [ -n "$s_pos3" ] &&
    [ "$s_pos1" -lt "$s_pos2" ] && [ "$s_pos2" -lt "$s_pos3" ] ||
    die "self-test: step summary must list partitions 1, 2, 3 in ascending order"

  # (h) invalid N values each exit 2
  for bad_n in 0 -1 abc ""; do
    set +e
    "$0" "$bad_n" >/dev/null 2>&1
    bad_status=$?
    set -e
    [ "$bad_status" -eq 2 ] ||
      die "self-test: N='$bad_n' must exit 2, got $bad_status"
  done

  # (i) every enumerated file was handed to exactly one partition (read back
  # from what the fake mix actually received in the all-pass case)
  local received="$self_test_dir/received.txt"
  cat "$all_pass_logs"/partition-*.log | sed -n 's/^FAKE_MIX_FILE=//p' | LC_ALL=C sort >"$received"
  [ -z "$(uniq -d <"$received")" ] ||
    die "self-test: a test file was handed to more than one partition: $(uniq -d <"$received")"
  cmp -s "$received" "$expected_files" ||
    die "self-test: the partitions must receive every enumerated file exactly once; got: $(cat "$received")"

  # (i, cont.) every partition that ran mix got both formatters, after the
  # files, plus the monitor's deadline (480 s budget - 30 s) and its own
  # timings file
  local i
  for i in 1 2 3; do
    [ "$(sed -n 's/^FAKE_MIX_FORMATTER=//p' "$all_pass_logs/partition-$i.log" | tr '\n' ' ')" = "ExUnit.CLIFormatter Threadline.Test.PartitionMonitor " ] ||
      die "self-test: partition $i must get --formatter ExUnit.CLIFormatter --formatter Threadline.Test.PartitionMonitor: $(cat "$all_pass_logs/partition-$i.log")"
    grep -qx 'FAKE_MIX_DEADLINE_MS=450000' "$all_pass_logs/partition-$i.log" ||
      die "self-test: partition $i must get THREADLINE_TEST_DEADLINE_MS=450000 from the default budget"
    grep -qx "FAKE_MIX_TIMINGS_FILE=$all_pass_logs/partition-timings-$i.tsv" "$all_pass_logs/partition-$i.log" ||
      die "self-test: partition $i must get its own THREADLINE_PARTITION_TIMINGS_FILE"
  done
  for bad_budget in 0 -5 abc 0480; do
    set +e
    CI_TEST_PARTITIONS_BUDGET_S="$bad_budget" MIX_BIN="$fake_mix" \
      CI_TEST_PARTITIONS_LOG_DIR="$self_test_dir/bad-budget" "$sandbox_script" 3 >/dev/null 2>&1
    bad_status=$?
    set -e
    [ "$bad_status" -eq 2 ] ||
      die "self-test: CI_TEST_PARTITIONS_BUDGET_S='$bad_budget' must exit 2, got $bad_status"
  done
  for bad_seam in CI_TEST_PARTITIONS_DIAG_WAIT_S CI_TEST_PARTITIONS_KILL_GRACE_S; do
    set +e
    env "$bad_seam=abc" MIX_BIN="$fake_mix" \
      CI_TEST_PARTITIONS_LOG_DIR="$self_test_dir/bad-budget" "$sandbox_script" 3 >/dev/null 2>&1
    bad_status=$?
    set -e
    [ "$bad_status" -eq 2 ] || die "self-test: $bad_seam=abc must exit 2, got $bad_status"
  done

  # (j) the unweighted file still ran
  grep -qx 'test/b/unweighted_test.exs' "$received" ||
    die "self-test: a file with no weight entry must still run"

  # (k) the stale weight entry was ignored (never handed to mix, no failure)
  grep -q 'gone_test.exs' "$received" &&
    die "self-test: a stale weight entry must not be handed to mix"

  # (l) the assignment is identical across two runs
  local first_assignment="$self_test_dir/first-assignment.tsv"
  cp "$all_pass_logs/assignment.tsv" "$first_assignment"
  run_case "repeat all pass" "pass,pass,pass"
  [ "$case_status" -eq 0 ] ||
    die "self-test: repeated all-pass case must exit 0, got $case_status: $output"
  cmp -s "$first_assignment" "$case_logs/assignment.tsv" ||
    die "self-test: two runs must produce the same assignment"
  for i in 1 2 3; do
    cmp -s "$all_pass_logs/partition-$i.files" "$case_logs/partition-$i.files" ||
      die "self-test: two runs must hand partition $i the same files"
  done

  # (m) the three heaviest files land in different partitions
  local heavy_bins
  heavy_bins="$(grep -lE '^FAKE_MIX_FILE=test/(a/heavy1|a/heavy2|b/heavy3)_test.exs$' \
    "$all_pass_logs"/partition-*.log | wc -l | tr -d ' ')"
  [ "$heavy_bins" -eq 3 ] ||
    die "self-test: the three heaviest files must land in three different partitions, got $heavy_bins"
  for i in 1 2 3; do
    [ "$(grep -cE '^FAKE_MIX_FILE=test/(a/heavy1|a/heavy2|b/heavy3)_test.exs$' "$all_pass_logs/partition-$i.log")" -eq 1 ] ||
      die "self-test: partition $i must hold exactly one of the three heaviest files"
  done

  # (q) a colocation group shares one partition: pairing the two heaviest
  # files (which (m) proves would otherwise split) puts them together, and
  # every file is still assigned exactly once
  local coloc_dir coloc_assign
  coloc_dir="$self_test_dir/colocate"
  mkdir -p "$coloc_dir"
  printf '# sandbox group\ntest/a/heavy1_test.exs test/a/heavy2_test.exs test/gone_test.exs\n' >"$coloc_dir/colocate.txt"
  (cd "$proj" && enumerate_test_files) >"$coloc_dir/enumerated.txt"
  coloc_assign="$coloc_dir/assignment.tsv"
  (cd "$proj" && assign_files 3 test/partition_weights.txt "$coloc_dir/enumerated.txt" "$coloc_dir/colocate.txt") >"$coloc_assign"
  [ "$(awk -F'\t' '$2 == "test/a/heavy1_test.exs" || $2 == "test/a/heavy2_test.exs" { print $1 }' "$coloc_assign" | LC_ALL=C sort -u | wc -l | tr -d ' ')" -eq 1 ] ||
    die "self-test: a colocation group must land in one partition, got: $(cat "$coloc_assign")"
  verify_assignment 3 "$coloc_dir/enumerated.txt" "$coloc_assign" ||
    die "self-test: a colocation group must keep every file assigned exactly once"

  # (x) the async factor arithmetic: at 250 permille the sandbox assignment
  # is exactly the old guessed 1/4 result, and at the fitted constant the
  # async file weighs ASYNC_FACTOR_PERMILLE thousandths of its measured time
  local factor_assign="$coloc_dir/factor.tsv" factor_expected
  factor_expected="$(printf '%s\t%s\t%s\n' \
    1 test/a/heavy1_test.exs 50000 \
    2 test/a/heavy2_test.exs 40000 \
    3 test/b/unweighted_test.exs 35000 \
    3 test/b/heavy3_test.exs 30000 \
    2 test/b/async_test.exs 10000 \
    1 test/b/light2_test.exs 2000 \
    2 test/a/light1_test.exs 1000)"
  (cd "$proj" && ASYNC_FACTOR_PERMILLE=250 assign_files 3 test/partition_weights.txt "$coloc_dir/enumerated.txt" /dev/null) >"$factor_assign"
  [ "$(cat "$factor_assign")" = "$factor_expected" ] ||
    die "self-test: ASYNC_FACTOR_PERMILLE=250 must reproduce the old 1/4 assignment, got: $(cat "$factor_assign")"
  (cd "$proj" && assign_files 3 test/partition_weights.txt "$coloc_dir/enumerated.txt" /dev/null) >"$factor_assign"
  [ "$(awk -F'\t' '$2 == "test/b/async_test.exs" { print $3 }' "$factor_assign")" = "$((40000 * ASYNC_FACTOR_PERMILLE / 1000))" ] ||
    die "self-test: an async file must weigh ASYNC_FACTOR_PERMILLE/1000 of its measured time, got: $(cat "$factor_assign")"

  # (n) a partition assigned no files (8 partitions, 7 files) never invokes
  # mix, exits 0 on its own, and does not mask a failing sibling
  run_case "zero-file partition with the rest passing" "pass,pass,pass,pass,pass,pass,pass,pass" 8
  [ "$case_status" -eq 0 ] ||
    die "self-test: a zero-file partition alongside passing ones must exit 0, got $case_status: $output"
  [ ! -s "$case_logs/partition-8.files" ] ||
    die "self-test: partition 8 of 8 must be assigned no files over 7 test files"
  grep -q 'has no test files assigned' "$case_logs/partition-8.log" ||
    die "self-test: the zero-file partition must not invoke mix"
  grep -q 'FAKE_MIX' "$case_logs/partition-8.log" &&
    die "self-test: the zero-file partition must not invoke mix"
  run_case "zero-file partition with a failing sibling" "fail,pass,pass,pass,pass,pass,pass,pass" 8
  [ "$case_status" -ne 0 ] ||
    die "self-test: a zero-file partition must not mask a failing sibling"

  # (o) the exactly-once check has teeth
  local bad="$self_test_dir/bad-assignment.tsv"
  local good="$self_test_dir/good-assignment.tsv"
  cp "$first_assignment" "$good"
  verify_assignment 3 "$expected_files" "$good" 2>/dev/null ||
    die "self-test: the exactly-once check must accept a correct assignment"
  { cat "$good"; head -1 "$good" | awk -F'\t' -v OFS='\t' '{ $1 = ($1 % 3) + 1; print }'; } >"$bad"
  verify_assignment 3 "$expected_files" "$bad" 2>/dev/null &&
    die "self-test: the exactly-once check must reject a file assigned twice"
  sed 1d "$good" >"$bad"
  verify_assignment 3 "$expected_files" "$bad" 2>/dev/null &&
    die "self-test: the exactly-once check must reject a dropped file"
  { printf '4\ttest/a/heavy1_test.exs\t1\n'; grep -v 'heavy1' "$good"; } >"$bad"
  verify_assignment 3 "$expected_files" "$bad" 2>/dev/null &&
    die "self-test: the exactly-once check must reject a partition outside 1-N"

  # (p) --write-weights turns --slowest-modules output into sorted per-file weights
  set +e
  output="$(
    MIX_BIN="$fake_mix" CI_TEST_PARTITIONS_LOG_DIR="$self_test_dir/weights-logs" \
      "$sandbox_script" --write-weights 2>&1
  )"
  status=$?
  set -e
  [ "$status" -eq 0 ] || die "self-test: --write-weights must exit 0, got $status: $output"
  [ "$(grep -v '^#' "$proj/test/partition_weights.txt")" = "15 test/a/two_test.exs
1500 test/one_test.exs" ] ||
    die "self-test: --write-weights must sum per file and sort by path, got: $(cat "$proj/test/partition_weights.txt")"
  grep -q '^# Regenerate with: bin/ci-test-partitions --write-weights$' "$proj/test/partition_weights.txt" ||
    die "self-test: the weights file must say how to regenerate it"
  grep -q '^# The runner tolerates stale or missing weights for assignment; every discovered test$' "$proj/test/partition_weights.txt" &&
    grep -q '^# still runs exactly once. The committed-inventory CI contract rejects either condition\.$' "$proj/test/partition_weights.txt" ||
    die "self-test: regenerated weights must distinguish assignment tolerance from committed-inventory rejection"

  # (r) --ingest-weights: per-file median over TSVs, absent files keep their
  # weight, header kept, rows path-sorted, >2x moves reported, malformed rows
  # ignored, and --lane selects TSVs by their header lane= field
  local ing="$self_test_dir/ingest"
  mkdir -p "$ing/run-2/nested"
  cat >"$proj/test/partition_weights.txt" <<'WEIGHTS'
# old header
100 test/a/heavy1_test.exs
5000 test/a/shrink_test.exs
7000 test/b/kept_test.exs
250 test/b/light2_test.exs
WEIGHTS
  {
    printf '# threadline.partition-timings/1 partition=1 lane=current boot_ms=900 wall_ms=5000\n'
    printf 'test/a/heavy1_test.exs\t900\t800\n'
    printf 'test/b/light2_test.exs\t100\t90\n'
    printf 'test/a/new_test.exs\t50\t40\n'
    printf 'test/a/shrink_test.exs\t1000\t900\n'
    printf 'lib/not_a_test.ex\t5\t5\n'
    printf 'test/b/bad_ms_test.exs\tabc\t1\n'
  } >"$ing/partition-timings-1.tsv"
  {
    printf '# threadline.partition-timings/1 partition=2 lane=current boot_ms=900 wall_ms=5000\n'
    printf 'test/a/heavy1_test.exs\t1000\t900\n'
    printf 'test/b/light2_test.exs\t300\t250\n'
  } >"$ing/run-2/partition-timings-2.tsv"
  {
    printf '# threadline.partition-timings/1 partition=1 lane=current boot_ms=900 wall_ms=5000\n'
    printf 'test/a/heavy1_test.exs\t800\t700\n'
    printf 'test/b/light2_test.exs\t200\t150\n'
  } >"$ing/run-2/nested/partition-timings-1.tsv"
  {
    printf '# threadline.partition-timings/1 partition=3 lane=min boot_ms=900 wall_ms=5000\n'
    printf 'test/b/light2_test.exs\t9000\t9000\n'
    printf 'test/b/min_only_test.exs\t4000\t3000\n'
  } >"$ing/partition-timings-3.tsv"
  local weights_before
  weights_before="$(cat "$proj/test/partition_weights.txt")"

  for bad_lane in 'x y' MIN 1abc '' nosuch; do
    set +e
    "$sandbox_script" --ingest-weights "$ing" --lane "$bad_lane" >/dev/null 2>&1
    bad_status=$?
    set -e
    [ "$bad_status" -eq 2 ] ||
      die "self-test: --ingest-weights --lane '$bad_lane' must exit 2, got $bad_status"
    [ "$(cat "$proj/test/partition_weights.txt")" = "$weights_before" ] ||
      die "self-test: a rejected --ingest-weights must leave the weights file unchanged"
  done
  mkdir -p "$self_test_dir/no-tsvs"
  set +e
  "$sandbox_script" --ingest-weights "$self_test_dir/no-tsvs" >/dev/null 2>&1
  bad_status=$?
  set -e
  [ "$bad_status" -eq 2 ] || die "self-test: --ingest-weights with no TSVs must exit 2, got $bad_status"

  set +e
  output="$("$sandbox_script" --ingest-weights "$ing" --lane current 2>&1)"
  status=$?
  set -e
  [ "$status" -eq 0 ] || die "self-test: --ingest-weights --lane current must exit 0, got $status: $output"
  [ "$(grep -v '^#' "$proj/test/partition_weights.txt")" = "900 test/a/heavy1_test.exs
50 test/a/new_test.exs
1000 test/a/shrink_test.exs
7000 test/b/kept_test.exs
200 test/b/light2_test.exs" ] ||
    die "self-test: --ingest-weights --lane current must take the per-file median, keep absent files and sort by path, got: $(cat "$proj/test/partition_weights.txt")"
  grep -qx 'ingest-weights: 4 files from 3 TSVs (1 skipped by --lane)' <<<"$output" ||
    die "self-test: --ingest-weights must report files, TSVs and lane skips: $output"
  grep -qx 'moved >2x: 100 -> 900 test/a/heavy1_test.exs' <<<"$output" ||
    die "self-test: --ingest-weights must report a >2x move: $output"
  grep -qx 'moved >2x: 5000 -> 1000 test/a/shrink_test.exs' <<<"$output" ||
    die "self-test: --ingest-weights must report a >2x drop: $output"
  grep -q 'moved >2x: .* test/b/light2_test.exs' <<<"$output" &&
    die "self-test: a change under 2x must not be reported as moved: $output"
  grep -q '^# Regenerate with: bin/ci-test-partitions --write-weights$' "$proj/test/partition_weights.txt" &&
    grep -q '^# The runner tolerates stale or missing weights for assignment; every discovered test$' "$proj/test/partition_weights.txt" &&
    grep -q '^# still runs exactly once. The committed-inventory CI contract rejects either condition\.$' "$proj/test/partition_weights.txt" ||
    die "self-test: --ingest-weights must write the standard header block"
  ls -A "$proj/test" | grep -q '^\.partition_weights' &&
    die "self-test: --ingest-weights must not leave its temporary file behind"

  # Without --lane every TSV counts: the min-lane file appears and the 4-value
  # median of light2 (100, 200, 300, 9000) is the lower middle, 200.
  set +e
  output="$("$sandbox_script" --ingest-weights "$ing" 2>&1)"
  status=$?
  set -e
  [ "$status" -eq 0 ] || die "self-test: --ingest-weights without --lane must exit 0, got $status: $output"
  grep -qx 'ingest-weights: 5 files from 4 TSVs (0 skipped by --lane)' <<<"$output" ||
    die "self-test: --ingest-weights without --lane must read every TSV: $output"
  grep -qx "4000 test/b/min_only_test.exs" "$proj/test/partition_weights.txt" &&
    grep -qx "200 test/b/light2_test.exs" "$proj/test/partition_weights.txt" ||
    die "self-test: --ingest-weights without --lane must include the min-lane TSV: $(cat "$proj/test/partition_weights.txt")"

  # (s) hang: partition 2 never finishes and ignores QUIT. With a 3 s budget
  # the watchdog names it, prints the backstop, TERMs its group (enough here)
  # and records Exit 124; the siblings pass; nothing is left running.
  local fake_psql="$self_test_dir/fake-psql"
  printf '#!/usr/bin/env bash\necho "FAKE_PSQL $*"\n' >"$fake_psql"
  chmod +x "$fake_psql"
  local hang_t0 hang_secs hang_limit
  hang_limit=$((3 + 2 + 2 + 6))
  hang_t0="$(date +%s)"
  CI_TEST_PARTITIONS_BUDGET_S=3 CI_TEST_PARTITIONS_DIAG_WAIT_S=2 CI_TEST_PARTITIONS_KILL_GRACE_S=2 \
    CI_TEST_PARTITIONS_PSQL="$fake_psql" run_case "hang" "pass,hang,pass"
  hang_secs=$(($(date +%s) - hang_t0))
  [ "$case_status" -ne 0 ] || die "self-test: a hung partition must exit non-zero: $output"
  [ "$hang_secs" -lt "$hang_limit" ] ||
    die "self-test: a hung partition must be stopped within budget + diagnosis + grace, took ${hang_secs}s"
  grep -qx 'status=124 reason=budget start=[0-9]* end=[0-9]*' "$case_logs/partition-2.status" ||
    die "self-test: a budget-killed partition must record status=124 reason=budget: $(cat "$case_logs/partition-2.status" 2>/dev/null)"
  grep -q '^| 2 | 124 |' "$case_summary" || die "self-test: the hung partition's row must show Exit 124: $(cat "$case_summary")"
  grep -q '^| 1 | 0 |' "$case_summary" && grep -q '^| 3 | 0 |' "$case_summary" ||
    die "self-test: the hung partition's siblings must pass: $(cat "$case_summary")"
  grep -qx 'ci-test-partitions: partition 2 exceeded budget 3s' <<<"$output" ||
    die "self-test: the watchdog must say the partition exceeded its budget: $output"
  grep -q 'sending QUIT to its BEAM' <<<"$output" || die "self-test: the watchdog must QUIT the BEAM first: $output"
  grep -q 'last 40 log lines' <<<"$output" && grep -q 'FAKE_MIX_PARTITION_MARKER=2' <<<"$output" &&
    grep -q '247hangsentinel' <<<"$output" && grep -q "FAKE_PSQL .*threadline_test2" <<<"$output" ||
    die "self-test: without an in-VM report the backstop must print the log tail, process tree and pg_stat_activity: $output"
  grep -q 'ignored SIGTERM' <<<"$output" && die "self-test: a TERM-able hang must not need SIGKILL: $output"
  grep -q 'exceeded budget 3s; killed' "$case_logs/partition-2.log" || die "self-test: the partition log must record the budget kill"
  grep -q '^| 2 | (no in-VM report; see the partition log) |$' "$case_summary" ||
    die "self-test: the hung table must say no in-VM report arrived: $(cat "$case_summary")"
  grep -qE 'FAKE_MIX|last 40|247hangsentinel|::warning' "$case_summary" &&
    die "self-test: the step summary must never carry raw log text: $(cat "$case_summary")"
  pgrep -f 247hangsentinel >/dev/null && die "self-test: a hung partition's process was left running"
  pgrep -f "$fake_mix" >/dev/null && die "self-test: a fake mix process was left running"

  # (t) hang_ignore_term: partition 3 ignores QUIT and TERM; only the group
  # KILL after the grace stops it.
  CI_TEST_PARTITIONS_BUDGET_S=3 CI_TEST_PARTITIONS_DIAG_WAIT_S=1 CI_TEST_PARTITIONS_KILL_GRACE_S=2 \
    CI_TEST_PARTITIONS_PSQL="$fake_psql" run_case "hang ignoring TERM" "pass,pass,hang_ignore_term"
  [ "$case_status" -ne 0 ] || die "self-test: a TERM-ignoring hang must exit non-zero: $output"
  grep -q 'partition 3 ignored SIGTERM for 2s; sending SIGKILL' <<<"$output" ||
    die "self-test: a TERM-ignoring hang must be escalated to SIGKILL: $output"
  grep -q '^| 3 | 124 |' "$case_summary" || die "self-test: the TERM-ignoring partition must show Exit 124: $(cat "$case_summary")"
  pgrep -f 247hangsentinel >/dev/null && die "self-test: a TERM-ignoring partition's process was left running"
  pgrep -f "$fake_mix" >/dev/null && die "self-test: a fake mix process was left running"

  # (u) hang_quit: partition 1 answers QUIT with ExUnit's abort list; no
  # backstop, and the summary names the unfinished tests.
  CI_TEST_PARTITIONS_BUDGET_S=3 CI_TEST_PARTITIONS_DIAG_WAIT_S=5 CI_TEST_PARTITIONS_KILL_GRACE_S=2 \
    CI_TEST_PARTITIONS_PSQL="$fake_psql" run_case "hang answering QUIT" "hang_quit,pass,pass"
  [ "$case_status" -ne 0 ] || die "self-test: a QUIT-answering hang must exit non-zero: $output"
  grep -q '^| 1 | 124 |' "$case_summary" || die "self-test: the QUIT-answering partition must show Exit 124: $(cat "$case_summary")"
  grep -q 'backstop' <<<"$output" && die "self-test: an in-VM report must skip the backstop: $output"
  grep -qF '| 1 | test waits on a lock forever [test/a/heavy1_test.exs:7] |' "$case_summary" &&
    grep -qF '| 1 | Sandbox.SetupAllTest [test/b/heavy3_test.exs] |' "$case_summary" ||
    die "self-test: the hung table must name the in-flight tests: $(cat "$case_summary")"
  grep -q 'Aborting test suite' "$case_summary" && die "self-test: the step summary must not carry raw log lines"
  pgrep -f "$fake_mix" >/dev/null && die "self-test: a fake mix process was left running"

  # (v) the max/min ratio row (D-12), over prepared partition files: never
  # a gate, a warning above 1.15 on stdout only, zero-file partitions and
  # unknown times excluded
  ratio_case() {
    # ratio_case <label> <seconds per partition; "-" = no files, "?" = unknown>
    local label="$1" dir k secs
    shift
    case_n=$((case_n + 1))
    dir="$self_test_dir/case-$case_n"
    mkdir -p "$dir/logs"
    k=0
    for secs in "$@"; do
      k=$((k + 1))
      printf '1 test, 0 failures\n' >"$dir/logs/partition-$k.log"
      case "$secs" in
        -) : >"$dir/logs/partition-$k.files"; secs=1 ;;
        *) printf 'test/x_test.exs\n' >"$dir/logs/partition-$k.files" ;;
      esac
      case "$secs" in
        '?') printf 'status=0\n' >"$dir/logs/partition-$k.status" ;;
        *) printf 'status=0 start=1000 end=%s\n' "$((1000 + secs))" >"$dir/logs/partition-$k.status" ;;
      esac
    done
    set +e
    output="$(CI_TEST_PARTITIONS_REPORT_ONLY="$dir/logs" GITHUB_STEP_SUMMARY="$dir/summary.md" "$sandbox_script" "$k" 2>&1)"
    case_status=$?
    set -e
    case_summary="$dir/summary.md"
    [ "$case_status" -eq 0 ] || die "self-test: ratio $label: the report must exit 0, got $case_status: $output"
  }
  ratio_case "uneven" 10 11 12 13
  grep -qx '| max/min | - | 1.30 | - |' "$case_summary" || die "self-test: 10/11/12/13 s must give ratio 1.30: $(cat "$case_summary")"
  grep -qx '::warning::partition ratio 1.30 exceeds 1.15' <<<"$output" ||
    die "self-test: a ratio above 1.15 must print a ::warning:: line: $output"
  grep -q '::warning' "$case_summary" && die "self-test: the ratio warning must stay out of the step summary"
  ratio_case "even" 10 10 11 11
  grep -qx '| max/min | - | 1.10 | - |' "$case_summary" || die "self-test: 10/10/11/11 s must give ratio 1.10: $(cat "$case_summary")"
  grep -q '::warning' <<<"$output" && die "self-test: a ratio of 1.10 must not warn: $output"
  ratio_case "zero-file partition excluded" 10 11 - 12
  grep -qx '| max/min | - | 1.20 | - |' "$case_summary" ||
    die "self-test: a zero-file partition must be left out of the ratio: $(cat "$case_summary")"
  ratio_case "unknown times" '?' '?' '?'
  grep -qx '| max/min | - | n/a | - |' "$case_summary" || die "self-test: all-unknown times must give n/a: $(cat "$case_summary")"
  grep -q '::warning' <<<"$output" && die "self-test: n/a must not warn: $output"

  # (w) lane scope: an 8th sandbox file tagged `@moduletag :repo_contract`
  # (added here so the 7-file cases above stay as they are). Unset/empty
  # scope runs it once; toolchain drops and counts it, and the exactly-once
  # check passes on the filtered set; an unknown scope exits 2
  local scoped_file="test/b/repo_contract_test.exs"
  printf 'defmodule Sandbox.RepoContractTest do\n  use ExUnit.Case\n  @moduletag :repo_contract\nend\n' \
    >"$proj/$scoped_file"
  printf '500 %s\n' "$scoped_file" >>"$proj/test/partition_weights.txt"
  run_case "scope unset" "pass,pass,pass"
  [ "$case_status" -eq 0 ] || die "self-test: an unset THREADLINE_TEST_SCOPE THREADLINE_CI_LANE must exit 0, got $case_status: $output"
  [ "$(cat "$case_logs"/partition-*.files | grep -cx "$scoped_file")" -eq 1 ] ||
    die "self-test: with THREADLINE_TEST_SCOPE unset the repo-contract file must run exactly once"
  THREADLINE_TEST_SCOPE=toolchain run_case "scope toolchain" "pass,pass,pass"
  [ "$case_status" -eq 0 ] ||
    die "self-test: THREADLINE_TEST_SCOPE=toolchain must pass the exactly-once check and exit 0, got $case_status: $output"
  cat "$case_logs"/partition-*.files | grep -qx "$scoped_file" &&
    die "self-test: THREADLINE_TEST_SCOPE=toolchain must drop the repo-contract file from every partition"
  [ "$(cat "$case_logs"/partition-*.files | wc -l | tr -d ' ')" -eq 7 ] ||
    die "self-test: THREADLINE_TEST_SCOPE=toolchain must keep the 7 other files"
  grep -qx 'ci-test-partitions: 1 repo-contract files run on the current lane only' <<<"$output" ||
    die "self-test: THREADLINE_TEST_SCOPE=toolchain must print the repo-contract count: $output"
  grep -qx 'ci-test-partitions: 1 repo-contract files run on the current lane only' "$case_summary" ||
    die "self-test: THREADLINE_TEST_SCOPE=toolchain must write the repo-contract count to the step summary"
  THREADLINE_TEST_SCOPE= run_case "scope empty" "pass,pass,pass"
  [ "$case_status" -eq 0 ] || die "self-test: an empty THREADLINE_TEST_SCOPE must exit 0, got $case_status: $output"
  [ "$(cat "$case_logs"/partition-*.files | grep -cx "$scoped_file")" -eq 1 ] ||
    die "self-test: an empty THREADLINE_TEST_SCOPE must run the repo-contract file exactly once"
  grep -q 'repo-contract files' <<<"$output" &&
    die "self-test: full scope must not print a repo-contract count: $output"
  THREADLINE_TEST_SCOPE=bogus run_case "scope bogus" "pass,pass,pass"
  [ "$case_status" -eq 2 ] || die "self-test: THREADLINE_TEST_SCOPE=bogus must exit 2, got $case_status"
  grep -q '^Usage: bin/ci-test-partitions' <<<"$output" ||
    die "self-test: THREADLINE_TEST_SCOPE=bogus must print the usage: $output"
  grep -q "THREADLINE_TEST_SCOPE must be empty or 'toolchain', got 'bogus'" <<<"$output" ||
    die "self-test: THREADLINE_TEST_SCOPE=bogus must name the bad value: $output"
  rm -f "$proj/$scoped_file"

  # (y) The min lane must select its own scoped measured weights.
  (cd "$proj" && enumerate_test_files) | while IFS= read -r f; do
    printf '1000 %s\n' "$f"
  done >"$proj/test/partition_weights_min.txt"
  THREADLINE_CI_LANE=min THREADLINE_TEST_SCOPE=toolchain run_case "min weights" "pass,pass,pass,pass" 4
  [ "$case_status" -eq 0 ] || die "self-test: min routing failed: $output"
  grep -q 'measured weight (test/partition_weights_min.txt)' <<<"$output" ||
    die "self-test: min lane must select its own weights: $output"
  [ "$(cat "$case_logs"/partition-*.files | LC_ALL=C sort)" = "$(cat "$expected_files")" ] ||
    die "self-test: min lane inventory mismatch"
  printf 'lane-min-routing: ok\n'

  printf 'ci-test-partitions self-test: ok (all pass, partition 2 fails, partitions 1+3 fail, partition-1-empty+2-fails, partition-1-empty+rest-pass, killed partition, summary order, invalid N, every file exactly once, unweighted file runs, stale weight ignored, deterministic assignment, heaviest files spread, zero-file partition, exactly-once check rejects bad assignments, write-weights, colocation group, monitor formatter and env, ingest-weights, hang, hang_ignore_term, hang_quit, max/min ratio, test scope, async factor)\n'
}

# --- Argument parsing ------------------------------------------------------------

case "${1:-}" in
  -h | --help)
    usage
    exit 0
    ;;
  --self-test)
    run_self_test
    exit 0
    ;;
  --write-weights)
    write_weights
    exit 0
    ;;
  --ingest-weights)
    shift
    ingest_weights "$@"
    exit 0
    ;;
esac

if [ $# -eq 0 ]; then
  N=4
else
  N="$1"
  case "$N" in
    [1-8]) ;;
    *)
      usage >&2
      die "N must be a positive integer from 1 to 8, got '$N'"
      ;;
  esac
fi

if [ -n "${CI_TEST_PARTITIONS_REPORT_ONLY:-}" ]; then
  # Test-only seam: the report alone, over prepared partition files.
  [ -d "$CI_TEST_PARTITIONS_REPORT_ONLY" ] || die "CI_TEST_PARTITIONS_REPORT_ONLY is not a directory: $CI_TEST_PARTITIONS_REPORT_ONLY"
  report "$N" "$CI_TEST_PARTITIONS_REPORT_ONLY" "-"
  exit 0
fi

run_partitions "$N"
