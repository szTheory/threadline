#!/usr/bin/env bash
# Post-publish distribution doc sync (DIST-01/DIST-02 attestation).
# Called from .github/workflows/release.yml after Hex registry confirms the version.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

VERSION="${1:-}"
TAG="${2:-}"
WORKFLOW_URL="${3:-}"
VERIFIED_DATE="${4:-}"

if [[ -z "$VERSION" || -z "$TAG" || -z "$WORKFLOW_URL" || -z "$VERIFIED_DATE" ]]; then
  echo "usage: $0 VERSION TAG WORKFLOW_URL VERIFIED_DATE" >&2
  echo "  e.g. $0 0.6.0 v0.6.0 https://github.com/org/threadline/actions/runs/123 2026-05-28" >&2
  exit 1
fi

ADOPTION_PILOT="guides/adoption-pilot-backlog.md"
EVALUATING="guides/evaluating-threadline.md"
VERIFICATION=".planning/phases/122-release-distribution-truth/122-VERIFICATION.md"
CONTRIBUTING="CONTRIBUTING.md"

HEX_EVIDENCE="Verified ${VERIFIED_DATE}: [hex.pm](https://hex.pm/packages/threadline) latest is **${VERSION}** (tag **\`${TAG}\`**). Publish workflow: ${WORKFLOW_URL}. Confirm locally: \`mix hex.info threadline\` ([CONTRIBUTING.md](../CONTRIBUTING.md#hex-publish-maintainers)). Doc contract: \`test/threadline/adoption_pilot_doc_contract_test.exs\`"

# adoption-pilot Hex row: Pending -> OK
python3 - <<PY
import pathlib
import re

path = pathlib.Path("${ADOPTION_PILOT}")
text = path.read_text()
evidence = """${HEX_EVIDENCE}"""
version = "${VERSION}"
escaped = re.escape(version)
pattern = (
    rf"(\| \`threadline\` \*\*{escaped}\*\* on \[Hex\]\(https://hex\.pm/packages/threadline\) \| )Pending( \| ).*?(\|)"
)
replacement = rf"\1OK\2{evidence}\3"
new_text, n = re.subn(pattern, replacement, text, count=1, flags=re.DOTALL)
if n != 1:
    raise SystemExit(f"expected exactly one Hex distribution row to update in {path}, got {n}")
path.write_text(new_text)
PY

# evaluating guide: remove lag caveat
python3 - <<'PY'
import pathlib

path = pathlib.Path("guides/evaluating-threadline.md")
text = path.read_text()
old = (
    "Threadline **0.6.0** is the in-repo and doc SSOT (`mix.exs` `@version`). "
    "As of 2026-05-27, [hex.pm](https://hex.pm/packages/threadline) may still list **0.5.0** as latest "
    "until maintainers push tag **`v0.6.0`** (see [`guides/adoption-pilot-backlog.md`](adoption-pilot-backlog.md) Distribution preflight)."
)
new = (
    "Threadline **0.6.0** is the in-repo, doc, and [Hex](https://hex.pm/packages/threadline) SSOT "
    "(`mix.exs` `@version`). See [`guides/adoption-pilot-backlog.md`](adoption-pilot-backlog.md) "
    "Distribution preflight for maintainer attestation and publish workflow evidence."
)
if old not in text:
    if new in text:
        print("evaluating guide already synced")
    else:
        raise SystemExit("evaluating-threadline.md lag paragraph not found")
else:
    path.write_text(text.replace(old, new, 1))
PY

# 122-VERIFICATION.md
mkdir -p "$(dirname "$VERIFICATION")"
cat >"$VERIFICATION" <<EOF
---
status: passed
phase: 122-release-distribution-truth
verified: ${VERIFIED_DATE}
requirements: DIST-01, DIST-02, DIST-03
---

# Phase 122 Verification Report

## Registry publish (DIST-01)

- Tag: \`${TAG}\`
- Workflow: ${WORKFLOW_URL}
- Registry excerpt (\`mix hex.info threadline\`, redacted):
  \`\`\`
  Recent releases include **${VERSION}** on hex.pm (verified ${VERIFIED_DATE} by release workflow).
  \`\`\`

## Adopter surfaces (DIST-02)

- adoption-pilot Hex row: OK with dated evidence (see \`${ADOPTION_PILOT}\`)
- evaluating-threadline: no \`may still list **0.5.0** as latest\` caveat

## CHANGELOG (DIST-03)

- \`[0.6.0]\` four-lane upgrade bullet lists \`phx-gen-auth-reference\`
- \`release_distribution_doc_contract_test.exs\` green via \`mix verify.doc_contract\`
EOF

# CONTRIBUTING cross-link (idempotent)
if ! grep -q '122-VERIFICATION.md' "$CONTRIBUTING"; then
  python3 - <<'PY'
import pathlib

path = pathlib.Path("CONTRIBUTING.md")
text = path.read_text()
needle = "5. Watch the **Hex publish** workflow on the Actions tab; confirm with **`mix hex.info threadline`** after the registry updates."
insert = needle + "\n\nPost-publish distribution proof for adopters: adoption-pilot Distribution preflight OK row in `guides/adoption-pilot-backlog.md` plus `.planning/phases/122-release-distribution-truth/122-VERIFICATION.md`."
if needle not in text:
    raise SystemExit("CONTRIBUTING.md anchor for post-publish cross-link not found")
path.write_text(text.replace(needle, insert, 1))
PY
fi

# Planning closeout: REQUIREMENTS, STATE, ROADMAP
python3 - <<PY
import pathlib
import re

req = pathlib.Path(".planning/REQUIREMENTS.md")
text = req.read_text()
for dist in ("DIST-01", "DIST-02", "DIST-03"):
    text, n = re.subn(
        rf"- \[ \] (\*\*{dist}\*\*:)",
        r"- [x] \1",
        text,
        count=1,
    )
    if n != 1:
        raise SystemExit(f"could not tick {dist} in REQUIREMENTS.md")
req.write_text(text)

state = pathlib.Path(".planning/STATE.md")
st = state.read_text()
st = re.sub(
    r"- \*\*Hex distribution\*\*: in-repo \*\*0\.6\.0\*\*; hex\.pm latest \*\*0\.5\.0\*\* until tag.*",
    "- **Hex distribution**: in-repo and hex.pm latest **0.6.0** (tag `${TAG}`, verified ${VERIFIED_DATE})",
    st,
    count=1,
)
if "hex.pm latest **0.6.0**" not in st:
    st = st.replace(
        "hex.pm latest **0.5.0**",
        "hex.pm latest **0.6.0**",
        1,
    )
state.write_text(st)

roadmap = pathlib.Path(".planning/ROADMAP.md")
rm = roadmap.read_text()
rm = re.sub(
    r"- \[ \] (\*\*Phase 122: Release & Distribution Truth\*\*)",
    r"- [x] \1",
    rm,
    count=1,
)
roadmap.write_text(rm)
PY

echo "Post-publish distribution sync complete for ${VERSION} (${TAG})."
