#!/usr/bin/env bash
# Post-publish distribution doc sync.
# Called from .github/workflows/release.yml after the Hex registry confirms the
# version. Version-agnostic and idempotent: it attests the just-published version
# in the adoption-pilot Hex distribution row. Re-running with the same arguments
# is a no-op.
#
# Ownership split (see release-please-config.json `extra-files`):
#   - The SSOT line ("Distribution preflight below reflects the **X** tree") is
#     bumped by release-please IN THE RELEASE COMMIT via the `generic` updater
#     (line carries an `x-release-please-version` annotation). This script must
#     NOT rewrite it — doing so would strip the annotation and silently break the
#     next release. The doc-contract test guards the wiring.
#   - This script owns ONLY the Hex attestation row (the "latest is X on Hex"
#     fact), which is only true AFTER publish.
#
# It deliberately touches ONLY guides/adoption-pilot-backlog.md. Other docs that
# mention a version (e.g. guides/evaluating-threadline.md) carry intentional
# historical narrative pinned by their own doc-contract tests and must not be
# auto-bumped here.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

VERSION="${1:-}"
TAG="${2:-}"
WORKFLOW_URL="${3:-}"
VERIFIED_DATE="${4:-}"

if [[ -z "$VERSION" || -z "$TAG" || -z "$WORKFLOW_URL" || -z "$VERIFIED_DATE" ]]; then
  echo "usage: $0 VERSION TAG WORKFLOW_URL VERIFIED_DATE" >&2
  echo "  e.g. $0 0.7.0 v0.7.0 https://github.com/org/threadline/actions/runs/123 2026-05-30" >&2
  exit 1
fi

ADOPTION_PILOT="guides/adoption-pilot-backlog.md"

VERSION="$VERSION" TAG="$TAG" WORKFLOW_URL="$WORKFLOW_URL" VERIFIED_DATE="$VERIFIED_DATE" \
ADOPTION_PILOT="$ADOPTION_PILOT" python3 - <<'PY'
import os
import pathlib
import re

version = os.environ["VERSION"]
tag = os.environ["TAG"]
workflow_url = os.environ["WORKFLOW_URL"]
verified_date = os.environ["VERIFIED_DATE"]
path = pathlib.Path(os.environ["ADOPTION_PILOT"])

text = path.read_text()
original = text

# NOTE: The SSOT line ("Distribution preflight below reflects the **X** tree") is
# intentionally NOT touched here — release-please owns it via `extra-files`
# (release-please-config.json) using the `x-release-please-version` annotation on
# that line. Rewriting it here would strip the annotation and break the next
# release. This script syncs ONLY the post-publish Hex attestation row below.

# Hex attestation row: replace the existing `threadline **<ver>** on [Hex]`
#    row with an OK row for the published version + dated evidence. Matches any
#    prior version so it is version-agnostic and idempotent.
evidence = (
    f"Verified {verified_date}: [hex.pm](https://hex.pm/packages/threadline) latest is "
    f"**{version}** (tag **`{tag}`**). Publish workflow: {workflow_url}. Confirm locally: "
    f"`mix hex.info threadline` ([CONTRIBUTING.md](../CONTRIBUTING.md#hex-publish-maintainers)). "
    f"Doc contract: `test/threadline/adoption_pilot_doc_contract_test.exs`"
)
hex_row = (
    f"| `threadline` **{version}** on [Hex](https://hex.pm/packages/threadline) | OK | {evidence} |"
)
text, n_row = re.subn(
    r"^\| `threadline` \*\*[^*]+\*\* on \[Hex\]\(https://hex\.pm/packages/threadline\) \|.*$",
    lambda _m: hex_row,
    text,
    count=1,
    flags=re.MULTILINE,
)
if n_row != 1:
    print(f"WARN: Hex attestation row not found in {path}; leaving as-is")

if text != original:
    path.write_text(text)
    print(f"adoption-pilot distribution preflight synced to {version}")
else:
    print(f"adoption-pilot distribution preflight already at {version} (no-op)")
PY

echo "Post-publish distribution sync complete for ${VERSION} (${TAG})."
