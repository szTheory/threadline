# shellcheck shell=bash
# Sourced library (no shebang, not executable on its own): the one SARIF
# parser for `mix hex.audit` (D-18, D-19). Consumers: bin/deps-health-report
# (SUP-04) and, from plan 245-02, bin/verify-deps-audit (SUP-03).
#
# Contract (Hex 2.6.0, lib/hex/sarif.ex): every result carries
# partialFingerprints["hexAudit/v1"] shaped
#   advisory:<repo>/<package>:<advisory id>
#   retired:<repo>/<package>          (no id; the SARIF ruleId HEX0001-HEX0005 is used)
#   denied:<repo>/<package>           (policy modes only; never expected here)
# Human hex.audit output is display only and is never classified.
#
# Fail-closed rules (D-19): a registry failure writes no SARIF file and leaves
# any pre-existing file untouched, so every audit gets a fresh `mktemp -d`
# directory and a never-pre-created path. A missing file, a jq failure, a
# non-zero exit with zero results, exit 0 with results, an unparseable
# fingerprint, or any kind other than advisory/retired is an audit shape error.
#
# Caller contract:
#   - sets ROOT (repo root) and MIX_BIN before sourcing;
#   - calls dat_cleanup from its single EXIT trap function.
# This library sets no `set -e`/`set +e` and installs no trap of its own; status
# capture uses the `cmd && st=0 || st=$?` form so the caller's errexit mode is
# neither tripped nor changed. bash 3.2-safe (no declare -A, no mapfile).
# hex.audit is deliberately not wrapped in bin/retry-network: real findings
# also exit 1 (D-19).

DAT_TMP_DIRS=()
DAT_AUDIT_OUTPUT=""

dat_cleanup() {
  local d
  for d in ${DAT_TMP_DIRS[@]+"${DAT_TMP_DIRS[@]}"}; do
    [ -z "$d" ] || rm -rf "$d"
  done
  DAT_TMP_DIRS=()
}

# Prints a fresh, never-created SARIF path inside a new registered temp dir.
dat_new_sarif_path() {
  local dir st
  mkdir -p "$ROOT/tmp" && st=0 || st=$?
  [ "$st" -eq 0 ] || return "$st"
  dir="$(mktemp -d "$ROOT/tmp/deps-audit-sarif.XXXXXX")" && st=0 || st=$?
  [ "$st" -eq 0 ] || return "$st"
  DAT_TMP_DIRS+=("$dir")
  printf '%s/audit.sarif\n' "$dir"
}

# dat_audit DIR SARIF_PATH: runs hex.audit in DIR, stores combined output in
# DAT_AUDIT_OUTPUT and returns the mix exit status.
dat_audit() {
  local dir="$1" sarif="$2" st
  DAT_AUDIT_OUTPUT="$(cd "$dir" && "$MIX_BIN" hex.audit --format sarif --output "$sarif" 2>&1)" && st=0 || st=$?
  return "$st"
}

# dat_findings SARIF_PATH: one TSV line per result,
#   <kind>\t<package>\t<id>\t<message>
# kind is advisory, retirement or denied; an unmatched fingerprint yields
#   UNPARSEABLE\t\t\t<fingerprint>
# A non-matching capture() yields no output at all (not null), so it is
# collected into an array whose first element is null on a non-match; without
# that, an unparseable result would silently vanish. Returns non-zero when the
# file is absent or jq fails.
dat_findings() {
  local sarif="$1"
  [ -f "$sarif" ] || return 1
  jq -r '.runs[0].results[]
    | (.partialFingerprints["hexAudit/v1"] // "") as $fp
    | ([$fp | capture("^(?<kind>advisory|retired|denied):(?<repo>[^/]+)/(?<pkg>[a-z0-9_]+)(:(?<id>.+))?$")?] | .[0]) as $m
    | if $m == null then "UNPARSEABLE\t\t\t\($fp)"
      else [(if $m.kind == "retired" then "retirement" else $m.kind end),
            $m.pkg, ($m.id // .ruleId // ""), (.message.text // "")] | @tsv end' "$sarif"
}

# dat_audit_shape_error STATUS SARIF_PATH: prints a one-line reason and returns
# 1 for every ambiguous audit shape; prints nothing and returns 0 otherwise.
dat_audit_shape_error() {
  local status="$1" sarif="$2" count rows st

  case "$DAT_AUDIT_OUTPUT" in
    *":json module is not available"*)
      printf 'SARIF needs OTP 27+ (hex.audit: :json module is not available)\n'
      return 1
      ;;
  esac

  if [ ! -f "$sarif" ]; then
    printf 'hex.audit exited %s and wrote no SARIF file\n' "$status"
    return 1
  fi

  count="$(jq -e '.runs[0].results | if type == "array" then length else error("no results array") end' "$sarif" 2>/dev/null)" && st=0 || st=$?
  if [ "$st" -ne 0 ] || [ -z "$count" ]; then
    printf 'SARIF file could not be parsed (jq exited %s)\n' "$st"
    return 1
  fi

  if [ "$status" -ne 0 ] && [ "$count" -eq 0 ]; then
    printf 'hex.audit exited %s with zero SARIF results\n' "$status"
    return 1
  fi

  if [ "$status" -eq 0 ] && [ "$count" -ne 0 ]; then
    printf 'hex.audit exited 0 with %s SARIF results\n' "$count"
    return 1
  fi

  rows="$(dat_findings "$sarif")" && st=0 || st=$?
  if [ "$st" -ne 0 ]; then
    printf 'SARIF results could not be parsed (jq exited %s)\n' "$st"
    return 1
  fi

  # Every SARIF result must yield exactly one row; a dropped row is a shape
  # error, never a silent clean.
  local line kind rest row_count=0
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    row_count=$((row_count + 1))
    kind="${line%%	*}"
    rest="${line#*	}"
    case "$kind" in
      advisory | retirement) ;;
      UNPARSEABLE)
        printf 'unparseable hexAudit/v1 fingerprint: %s\n' "${rest##*	}"
        return 1
        ;;
      *)
        printf 'unexpected hex.audit finding kind: %s\n' "$kind"
        return 1
        ;;
    esac
  done <<EOF
$rows
EOF

  if [ "$row_count" -ne "$count" ]; then
    printf 'parsed %s findings from %s SARIF results\n' "$row_count" "$count"
    return 1
  fi

  return 0
}
