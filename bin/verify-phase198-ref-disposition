#!/usr/bin/env bash
# Fail-closed Phase-198 ref inventory and mutation-authority verifier.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

die() { echo "verify-phase198-ref-disposition: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "$1 is required"; }
sha256() { shasum -a 256 | awk '{print $1}'; }

need jq
need git
need shasum

stage="${1:-}"
[[ "$stage" =~ ^(inventory|decision|authority|controls|post-target|final)$ ]] ||
  die "stage must be inventory, decision, authority, controls, post-target, or final"
shift || true

inventory=""
decision=""
register=""
target=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --inventory) [[ $# -ge 2 ]] || die "--inventory requires a value"; inventory="$2"; shift 2 ;;
    --decision) [[ $# -ge 2 ]] || die "--decision requires a value"; decision="$2"; shift 2 ;;
    --register) [[ $# -ge 2 ]] || die "--register requires a value"; register="$2"; shift 2 ;;
    --target) [[ $# -ge 2 ]] || die "--target requires a value"; target="$2"; shift 2 ;;
    *) die "unknown argument: $1" ;;
  esac
done

[[ -f "$inventory" ]] || die "inventory file is required"
[[ -f "$decision" ]] || die "decision Markdown file is required"

schema_version=$(jq -r '.schema_version // empty' "$inventory")

validate_schema_v2() {
  jq -e '
    def exact($ks): (keys | sort) == ($ks | sort);
    def sha: type == "string" and test("^[0-9a-f]{40}$");
    def digest: type == "string" and test("^[0-9a-f]{64}$");
    def ts: type == "string" and test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$");
    def count_pair: exact(["ahead","behind"]) and (.ahead|type)=="number" and .ahead>=0 and (.behind|type)=="number" and .behind>=0;
    def commit: exact(["sha","subject"]) and (.sha|sha) and (.subject|type)=="string" and (.subject|length)>0;
    def stat: exact(["added","deleted","path"]) and (.added|type)=="number" and (.deleted|type)=="number" and (.path|type)=="string";
    def evidence:
      exact(["sha","merge_base_head","merge_base_main","ancestor_of_head","ancestor_of_main","vs_head","vs_main","unique_vs_head","unique_vs_main","diffstat_vs_head","diffstat_vs_main"])
      and (.sha|sha) and (.merge_base_head|sha) and (.merge_base_main|sha)
      and (.ancestor_of_head|type)=="boolean" and (.ancestor_of_main|type)=="boolean"
      and (.vs_head|count_pair) and (.vs_main|count_pair)
      and (.unique_vs_head|type)=="array" and all(.unique_vs_head[]; commit)
      and (.unique_vs_main|type)=="array" and all(.unique_vs_main[]; commit)
      and (.diffstat_vs_head|type)=="array" and all(.diffstat_vs_head[]; stat)
      and (.diffstat_vs_main|type)=="array" and all(.diffstat_vs_main[]; stat);
    def pr:
      exact(["number","state","is_draft","merge_state","head","base","head_sha"])
      and (.number|type)=="number" and (.state|type)=="string" and (.is_draft|type)=="boolean"
      and (.merge_state|type)=="string" and (.head|type)=="string" and (.base|type)=="string" and (.head_sha|sha);
    def controls:
      exact(["origin_main_sha","pr34","ruleset_protection_digest","classic_protection","required_contexts","required_contexts_digest","worktrees","worktree_list_digest"])
      and (.origin_main_sha|sha) and (.pr34|pr) and .pr34.number==34
      and (.ruleset_protection_digest|digest) and (.classic_protection=="absent" or .classic_protection=="present")
      and (.required_contexts|type)=="array" and all(.required_contexts[]; type=="string")
      and (.required_contexts_digest|digest)
      and (.worktrees|type)=="array" and all(.worktrees[]; exact(["path","branch"]) and (.path|type)=="string" and (.branch|type)=="string")
      and (.worktree_list_digest|digest);
    exact(["schema_version","round","observed_at","repository","provenance","task_baseline","target_universe","stable_controls","preservation_subjects","decision","execution","command_receipts"])
    and .schema_version==2 and .round==11 and (.observed_at|ts) and (.repository|type)=="string"
    and (.provenance|exact(["active_branch","active_head_sha","upstream","upstream_sha","authority"]))
    and (.provenance.active_head_sha|sha) and (.provenance.upstream_sha|sha) and .provenance.authority==false
    and (.task_baseline|exact(["active_branch","active_head_sha","upstream","upstream_sha"]))
    and (.task_baseline.active_head_sha|sha) and (.task_baseline.upstream_sha|sha)
    and (.target_universe|exact(["local","remote"]))
    and ((.target_universe.local|length)+(.target_universe.remote|length)>0)
    and all(.target_universe.local[],.target_universe.remote[]; exact(["branch","sha"]) and (.branch|test("^ci/198-")) and (.sha|sha))
    and (.stable_controls|controls)
    and (.preservation_subjects|type)=="array" and (.preservation_subjects|length)>0
    and all(.preservation_subjects[];
      exact(["id","branch","side","sha","evidence","pull_request","recommendation","archive_tag","restore_command"])
      and (.side=="local" or .side=="origin") and (.branch|test("^ci/198-")) and (.sha|sha)
      and .id==(.side+":"+.branch+"@"+.sha) and .evidence.sha==.sha and (.evidence|evidence)
      and (.pull_request==null or (.pull_request|pr))
      and (.recommendation|exact(["action","rationale"])) and (.recommendation.action=="retire" or .recommendation.action=="preserve") and (.recommendation.rationale|length)>0
      and (.archive_tag|test("^archive/ci/198-[^ ]+/(local|origin)-[0-9a-f]{12}$"))
      and .restore_command==("git branch "+.branch+" "+.sha))
    and ([.preservation_subjects[].id]|unique|length)==(.preservation_subjects|length)
    and ([.preservation_subjects[].archive_tag]|unique|length)==(.preservation_subjects|length)
    and (. as $root | all(.preservation_subjects[];
      . as $s | any((if $s.side=="local" then $root.target_universe.local else $root.target_universe.remote end)[]; .branch==$s.branch and .sha==$s.sha)))
    and (. as $root | all(.preservation_subjects[]|select(.pull_request!=null); . as $s |
      $s.pull_request.head==$s.branch and $s.pull_request.base=="main"
      and any($root.target_universe.remote[]; .branch==$s.pull_request.head and .sha==$s.pull_request.head_sha)))
    and (.decision==null or (.decision|type)=="object")
    and (.execution==null or (.execution|type)=="object") and (.command_receipts|type)=="array"
  ' "$inventory" >/dev/null || die "round-11 schema or preservation-subject validation failed"

  local context_digest worktree_digest
  context_digest=$(jq -cS '.stable_controls.required_contexts' "$inventory" | tr -d '\n' | sha256)
  worktree_digest=$(jq -cS '.stable_controls.worktrees' "$inventory" | tr -d '\n' | sha256)
  [[ "$context_digest" == "$(jq -r '.stable_controls.required_contexts_digest' "$inventory")" ]] || die "required-context digest mismatch"
  [[ "$worktree_digest" == "$(jq -r '.stable_controls.worktree_list_digest' "$inventory")" ]] || die "worktree-list digest mismatch"
}

validate_markdown_v2() {
  local digest controls_marker
  digest=$(inventory_digest)
  grep -Fq '<!-- schema: phase198-ref-disposition/v2; round: 11 -->' "$decision" || die "round-11 Markdown schema marker is absent"
  grep -Fq "<!-- inventory-sha256: ${digest} -->" "$decision" || die "Markdown inventory digest is absent or stale"
  while IFS=$'\t' read -r id archive_tag restore_command; do
    grep -Fq "<!-- subject: ${id}|${archive_tag}|${restore_command} -->" "$decision" || die "Markdown/JSON subject join mismatch for $id"
  done < <(jq -r '.preservation_subjects[] | [.id,.archive_tag,.restore_command] | @tsv' "$inventory")
  controls_marker=$(jq -r '.stable_controls | [.origin_main_sha,(.pr34.number|tostring),.pr34.head_sha,.ruleset_protection_digest,.required_contexts_digest,.worktree_list_digest] | join("|")' "$inventory")
  grep -Fq "<!-- controls: ${controls_marker} -->" "$decision" || die "Markdown/JSON stable-control join mismatch"
  grep -Fq 'Plan 52 is preserved but superseded as inapplicable because Plan 51 recorded verbatim abort and proved the exact-three scope incomplete.' "$decision" || die "Plan-52 supersession marker is absent"
}

live_compare_v2() {
  if [[ -n "${PHASE198_REF_DISPOSITION_LIVE_FIXTURE:-}" ]]; then
    [[ -f "$PHASE198_REF_DISPOSITION_LIVE_FIXTURE" ]] || die "live fixture does not exist"
    jq -e --slurpfile live "$PHASE198_REF_DISPOSITION_LIVE_FIXTURE" '
      .target_universe==$live[0].target_universe and .stable_controls==$live[0].stable_controls
      and .task_baseline==$live[0].task_baseline
      and all(.preservation_subjects[]; . as $s |
        if $s.pull_request==null then ($live[0].pull_requests|has($s.branch)|not)
        else $live[0].pull_requests[$s.branch]==$s.pull_request end)
    ' "$inventory" >/dev/null || die "round-11 fixture live-state equality failed"
    return
  fi

  live_compare_controls_v2
  local actual_local actual_remote
  actual_local=$(git for-each-ref --format='%(refname:short) %(objectname)' 'refs/heads/ci/198-*' | sort | jq -Rsc 'split("\n")[:-1] | map(capture("^(?<branch>[^ ]+) (?<sha>[0-9a-f]{40})$"))')
  actual_remote=$(git ls-remote --heads origin 'refs/heads/ci/198-*' | sort -k2 | jq -Rsc 'split("\n")[:-1] | map(capture("^(?<sha>[0-9a-f]{40})\\trefs/heads/(?<branch>.+)$"))')
  jq -e --argjson local "$actual_local" --argjson remote "$actual_remote" '.target_universe.local==$local and .target_universe.remote==$remote' "$inventory" >/dev/null || die "complete ci/198-* target universe drifted"

  local id branch sha mb_head mb_main counts_head counts_main baseline_head pr_json
  baseline_head=$(jq -r .task_baseline.active_head_sha "$inventory")
  while IFS=$'\t' read -r id branch sha mb_head mb_main counts_head counts_main; do
    [[ "$(git merge-base "$sha" "$baseline_head")" == "$mb_head" ]] || die "$id baseline-HEAD merge base drifted"
    [[ "$(git merge-base "$sha" main)" == "$mb_main" ]] || die "$id local-main merge base drifted"
    [[ "$(git rev-list --left-right --count "$sha"..."$baseline_head" | tr $'\t' '|')" == "$counts_head" ]] || die "$id baseline-HEAD ancestry counts drifted"
    [[ "$(git rev-list --left-right --count "$sha"...main | tr $'\t' '|')" == "$counts_main" ]] || die "$id local-main ancestry counts drifted"
    [[ "$(git rev-list --count "$sha" --not "$baseline_head")" -eq "$(jq -r --arg id "$id" '.preservation_subjects[]|select(.id==$id)|.evidence.unique_vs_head|length' "$inventory")" ]] || die "$id unique-commit evidence drifted"
    [[ "$(git diff --numstat "$baseline_head"..."$sha" | wc -l | tr -d ' ')" -eq "$(jq -r --arg id "$id" '.preservation_subjects[]|select(.id==$id)|.evidence.diffstat_vs_head|length' "$inventory")" ]] || die "$id numstat evidence drifted"
  done < <(jq -r '.preservation_subjects[] | [.id,.branch,.sha,.evidence.merge_base_head,.evidence.merge_base_main,((.evidence.vs_head.ahead|tostring)+"|"+(.evidence.vs_head.behind|tostring)),((.evidence.vs_main.ahead|tostring)+"|"+(.evidence.vs_main.behind|tostring))] | @tsv' "$inventory")

  while IFS=$'\t' read -r branch number state draft merge head base head_sha; do
    pr_json=$(gh pr view "$number" --json number,state,isDraft,mergeStateStatus,headRefName,baseRefName,headRefOid 2>/dev/null) || die "PR #$number unavailable"
    jq -e --argjson n "$number" --arg state "$state" --argjson draft "$draft" --arg merge "$merge" --arg head "$head" --arg base "$base" --arg sha "$head_sha" '.number==$n and .state==$state and .isDraft==$draft and .mergeStateStatus==$merge and .headRefName==$head and .baseRefName==$base and .headRefOid==$sha' <<<"$pr_json" >/dev/null || die "PR #$number drifted"
  done < <(jq -r '[.preservation_subjects[]|select(.pull_request!=null)|.pull_request]|unique_by(.number)[]|[.head,(.number|tostring),.state,.is_draft,.merge_state,.head,.base,.head_sha]|@tsv' "$inventory")
}

live_compare_controls_v2() {
  need gh
  local repo origin_main rules rules_digest contexts contexts_digest classic classic_output classic_exit
  repo=$(gh repo view --json nameWithOwner --jq .nameWithOwner 2>/dev/null) || die "could not resolve repository"
  [[ "$repo" == "$(jq -r .repository "$inventory")" ]] || die "repository mismatch"
  origin_main=$(git ls-remote --heads origin refs/heads/main | awk 'NF {print $1}')
  [[ "$origin_main" == "$(jq -r .stable_controls.origin_main_sha "$inventory")" ]] || die "origin/main drifted"
  local pr34_json
  pr34_json=$(gh pr view 34 --json number,state,isDraft,mergeStateStatus,headRefName,baseRefName,headRefOid 2>/dev/null) || die "PR #34 unavailable"
  jq -e --argjson live "$pr34_json" '.stable_controls.pr34 == {number:$live.number,state:$live.state,is_draft:$live.isDraft,merge_state:$live.mergeStateStatus,head:$live.headRefName,base:$live.baseRefName,head_sha:$live.headRefOid}' "$inventory" >/dev/null || die "PR #34 drifted"
  rules=$(gh api "repos/${repo}/rules/branches/main" 2>/dev/null) || die "effective rules unavailable"
  set +e
  classic_output=$(gh api --include --silent "repos/${repo}/branches/main/protection" 2>&1); classic_exit=$?
  set -e
  if [[ $classic_exit -eq 0 ]]; then classic=present; elif grep -Eq '^HTTP/[0-9.]+ 404 ' <<<"$classic_output"; then classic=absent; else die "classic protection observation failed"; fi
  rules_digest=$(jq -cnS --argjson rules "$(jq -cS . <<<"$rules")" --arg classic "$classic" '{classic_protection:$classic,effective_rules:$rules}' | tr -d '\n' | sha256)
  contexts=$(jq -cS '[.[] | select(.type=="required_status_checks") | .parameters.required_status_checks[]?.context] | unique | sort' <<<"$rules")
  contexts_digest=$(printf '%s' "$contexts" | sha256)
  [[ "$rules_digest" == "$(jq -r .stable_controls.ruleset_protection_digest "$inventory")" ]] || die "ruleset/protection drifted"
  [[ "$contexts" == "$(jq -cS .stable_controls.required_contexts "$inventory")" && "$contexts_digest" == "$(jq -r .stable_controls.required_contexts_digest "$inventory")" ]] || die "required contexts drifted"
  live_worktree_compare
}

validate_inventory_v2() {
  validate_schema_v2
  validate_markdown_v2
  complete_subjects_v2
  [[ "$(jq -r '.decision==null and .execution==null and (.command_receipts|length)==0' "$inventory")" == true ]] || die "inventory stage forbids decision, execution, or write-side command receipts"
  live_compare_v2
}

complete_subjects_v2() {
  jq -e '
    ([.target_universe.local[] | {id:("local:"+.branch+"@"+.sha),branch,side:"local",sha}] +
     [.target_universe.remote[] | {id:("origin:"+.branch+"@"+.sha),branch,side:"origin",sha}] | sort_by(.id)) ==
    ([.preservation_subjects[] | {id,branch,side,sha}] | sort_by(.id))
  ' "$inventory" >/dev/null || die "preservation subjects do not exactly cover the complete initial namespace"
}

extract_decision_v2() {
  awk '/^<!-- maintainer-decision-json$/{on=1;next}/^-->$/{if(on){exit}}on' "$decision"
}

validate_decision_v2() {
  validate_schema_v2
  validate_markdown_v2
  complete_subjects_v2
  local payload digest subjects option verbatim
  payload=$(extract_decision_v2)
  jq -e '
    type=="object" and (keys|sort)==(["option","verbatim","recorded_at","inventory_sha256","subjects"]|sort)
    and (.option=="retire" or .option=="preserve" or .option=="abort")
    and (.verbatim|type)=="string" and (.recorded_at|type)=="string"
  ' <<<"$payload" >/dev/null || die "round-11 maintainer decision is absent or malformed"
  digest=$(inventory_digest)
  [[ "$(jq -r .inventory_sha256 <<<"$payload")" == "$digest" ]] || die "decision inventory digest mismatch"
  subjects=$(jq -cS '[.preservation_subjects[]|{id,branch,side,sha,archive_tag}]' "$inventory")
  [[ "$(jq -cS .subjects <<<"$payload")" == "$subjects" ]] || die "decision subjects mismatch"
  [[ "$(jq -cS .decision "$inventory")" == "$(jq -cS . <<<"$payload")" ]] || die "JSON/Markdown decision mismatch"
  option=$(jq -r .option <<<"$payload"); verbatim=$(jq -r .verbatim <<<"$payload")
  case "$option" in
    retire) [[ "$verbatim" == retire ]] || die "retire must be recorded verbatim" ;;
    abort) [[ "$verbatim" == abort ]] || die "abort must be recorded verbatim" ;;
    preserve) [[ "$verbatim" == preserve\ * ]] || die "preserve response must be recorded verbatim" ;;
  esac
}

validate_fixture_controls_v2() {
  [[ -n "${PHASE198_REF_DISPOSITION_LIVE_FIXTURE:-}" ]] || { live_compare_controls_v2; return; }
  jq -e --slurpfile live "$PHASE198_REF_DISPOSITION_LIVE_FIXTURE" '
    .stable_controls==$live[0].stable_controls and .task_baseline==$live[0].task_baseline
  ' "$inventory" >/dev/null || die "stable controls or task-local baseline drifted"
}

validate_receipt_shape_v2() {
  jq -e '
    (.command_receipts|type)=="array"
    and ([.command_receipts[].seq] == (if (.command_receipts|length)==0 then [] else [range(1;(.command_receipts|length)+1)] end))
    and all(.command_receipts[];
      (.type|IN("local-annotated-tag","remote-single-tag","archive-register-row","pr-close","remote-ref-delete","local-ref-delete"))
      and (.target|type)=="string"
      and (if (.type|IN("local-annotated-tag","remote-single-tag","archive-register-row"))
           then ((.subject_id|type)=="string" and (.tag|type)=="string" and (.sha|type)=="string")
           elif .type=="pr-close" then (.pr|type)=="number"
           else true end))
  ' "$inventory" >/dev/null || die "command receipt shape or sequence ordering is invalid"
}

validate_subject_preservation_v2() {
  local subject_id="$1" marker
  jq -e --arg id "$subject_id" '
    . as $root | (.preservation_subjects[]|select(.id==$id)) as $s |
    ([.command_receipts[]|select(.subject_id==$id and .type=="local-annotated-tag" and .tag==$s.archive_tag and .sha==$s.sha)]|length)==1 and
    ([.command_receipts[]|select(.subject_id==$id and .type=="remote-single-tag" and .tag==$s.archive_tag and .sha==$s.sha)]|length)==1 and
    ([.command_receipts[]|select(.subject_id==$id and .type=="archive-register-row" and .tag==$s.archive_tag and .sha==$s.sha)]|length)==1 and
    ([.command_receipts[]|select(.subject_id==$id and .type=="local-annotated-tag")][0].seq <
     [.command_receipts[]|select(.subject_id==$id and .type=="remote-single-tag")][0].seq) and
    ([.command_receipts[]|select(.subject_id==$id and .type=="remote-single-tag")][0].seq <
     [.command_receipts[]|select(.subject_id==$id and .type=="archive-register-row")][0].seq)
  ' "$inventory" >/dev/null || die "subject $subject_id lacks ordered local-tag, remote-tag, and register preservation"
  [[ -f "$register" ]] || die "archive register is required"
  marker=$(jq -r --arg id "$subject_id" '.preservation_subjects[]|select(.id==$id)|"<!-- archive-subject: \(.id)|\(.archive_tag)|\(.sha)|\(.restore_command) -->"' "$inventory")
  grep -Fq "$marker" "$register" || die "archive register does not join subject $subject_id"
}

validate_live_tags_v2() {
  local subject_id="$1"
  [[ -n "${PHASE198_REF_DISPOSITION_LIVE_FIXTURE:-}" ]] || die "mutation-stage live validation requires the explicit data-only adapter"
  jq -e --arg id "$subject_id" --slurpfile live "$PHASE198_REF_DISPOSITION_LIVE_FIXTURE" '
    (.preservation_subjects[]|select(.id==$id)) as $s |
    any($live[0].local_tags[]; .tag==$s.archive_tag and .sha==$s.sha and .annotated==true) and
    any($live[0].remote_tags[]; .tag==$s.archive_tag and .sha==$s.sha)
  ' "$inventory" >/dev/null || die "live peeled archive tags do not preserve subject $subject_id"
}

validate_post_target_v2() {
  [[ -n "$target" ]] || die "post-target requires --target"
  validate_decision_v2
  [[ "$(jq -r .decision.option "$inventory")" == retire ]] || die "only retire grants mutation authority"
  validate_fixture_controls_v2
  validate_receipt_shape_v2
  jq -e --arg target "$target" 'any(.preservation_subjects[];.branch==$target)' "$inventory" >/dev/null || die "target is outside exact authority"

  local subject_id max_preserve pr expected_pr_close
  while IFS= read -r subject_id; do
    validate_subject_preservation_v2 "$subject_id"
    validate_live_tags_v2 "$subject_id"
  done < <(jq -r --arg target "$target" '.preservation_subjects[]|select(.branch==$target)|.id' "$inventory")

  max_preserve=$(jq -r --arg target "$target" '[.command_receipts[]|select(.target==$target and (.type|IN("local-annotated-tag","remote-single-tag","archive-register-row")))|.seq]|max' "$inventory")
  jq -e --arg target "$target" --argjson max "$max_preserve" '
    all(.command_receipts[]|select(.target==$target and (.type|IN("pr-close","remote-ref-delete","local-ref-delete"))); .seq>$max)
  ' "$inventory" >/dev/null || die "retirement receipt precedes complete target preservation"

  jq -e --arg target "$target" --slurpfile live "$PHASE198_REF_DISPOSITION_LIVE_FIXTURE" '
    all($live[0].target_universe.local[], $live[0].target_universe.remote[]; .branch!=$target)
  ' "$inventory" >/dev/null || die "target still exists in a live local or remote namespace"

  pr=$(jq -c --arg target "$target" '[.preservation_subjects[]|select(.branch==$target and .pull_request!=null)|.pull_request][0] // null' "$inventory")
  expected_pr_close=$(jq -r --arg target "$target" '[.command_receipts[]|select(.target==$target and .type=="pr-close")]|length' "$inventory")
  if [[ "$pr" == null ]]; then
    [[ "$expected_pr_close" -eq 0 ]] || die "null PR association must not invent a close receipt"
  else
    [[ "$expected_pr_close" -eq 1 ]] || die "associated PR requires exactly one close receipt"
    jq -e --arg target "$target" --argjson pr "$pr" --slurpfile live "$PHASE198_REF_DISPOSITION_LIVE_FIXTURE" '
      $live[0].pull_requests[$target].state=="CLOSED" and
      any(.command_receipts[];.target==$target and .type=="pr-close" and .pr==$pr.number)
    ' "$inventory" >/dev/null || die "associated PR is not closed with an exact receipt"
  fi
}

validate_final_v2() {
  validate_decision_v2
  [[ "$(jq -r .decision.option "$inventory")" == retire ]] || die "only retire grants mutation authority"
  validate_fixture_controls_v2
  validate_receipt_shape_v2
  [[ -n "${PHASE198_REF_DISPOSITION_LIVE_FIXTURE:-}" ]] || die "final validation requires the explicit data-only adapter"
  jq -e --slurpfile live "$PHASE198_REF_DISPOSITION_LIVE_FIXTURE" '
    ($live[0].target_universe.local|length)==0 and ($live[0].target_universe.remote|length)==0 and
    $live[0].green07_status=="Pending"
  ' "$inventory" >/dev/null || die "final requires live-derived empty namespaces and GREEN-07 Pending"
  local subject_id target
  while IFS= read -r subject_id; do validate_subject_preservation_v2 "$subject_id"; validate_live_tags_v2 "$subject_id"; done < <(jq -r '.preservation_subjects[].id' "$inventory")
  while IFS= read -r target; do
    jq -e --arg target "$target" '
      (.preservation_subjects|map(select(.branch==$target))|map(.side)) as $sides |
      (if ($sides|index("origin")) then any(.command_receipts[];.target==$target and .type=="remote-ref-delete") else true end) and
      (if ($sides|index("local")) then any(.command_receipts[];.target==$target and .type=="local-ref-delete") else true end)
    ' "$inventory" >/dev/null || die "final deletion receipts are incomplete for $target"
    local pr
    pr=$(jq -c --arg target "$target" '[.preservation_subjects[]|select(.branch==$target and .pull_request!=null)|.pull_request][0] // null' "$inventory")
    if [[ "$pr" != null ]]; then
      jq -e --arg target "$target" --argjson pr "$pr" --slurpfile live "$PHASE198_REF_DISPOSITION_LIVE_FIXTURE" '
        $live[0].pull_requests[$target].state=="CLOSED" and any(.command_receipts[];.target==$target and .type=="pr-close" and .pr==$pr.number)
      ' "$inventory" >/dev/null || die "final PR closure is incomplete for $target"
    fi
  done < <(jq -r '[.preservation_subjects[].branch]|unique[]' "$inventory")
}

validate_schema() {
  jq -e '
    def exact($ks): (keys | sort) == ($ks | sort);
    def sha: type == "string" and test("^[0-9a-f]{40}$");
    def digest: type == "string" and test("^[0-9a-f]{64}$");
    def ts: type == "string" and test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$");
    def count_pair: exact(["ahead","behind"]) and (.ahead|type)=="number" and .ahead>=0 and (.behind|type)=="number" and .behind>=0;
    def commit: exact(["sha","subject"]) and (.sha|sha) and (.subject|type)=="string" and (.subject|length)>0;
    def stat: exact(["added","deleted","path"]) and (.added|type)=="number" and (.deleted|type)=="number" and (.path|type)=="string";
    def ref:
      exact(["sha","merge_base_head","merge_base_main","ancestor_of_head","ancestor_of_main","vs_head","vs_main","unique_vs_head","unique_vs_main","diffstat_vs_head","diffstat_vs_main"])
      and (.sha|sha) and (.merge_base_head|sha) and (.merge_base_main|sha)
      and (.ancestor_of_head|type)=="boolean" and (.ancestor_of_main|type)=="boolean"
      and (.vs_head|count_pair) and (.vs_main|count_pair)
      and (.unique_vs_head|type)=="array" and all(.unique_vs_head[]; commit)
      and (.unique_vs_main|type)=="array" and all(.unique_vs_main[]; commit)
      and (.diffstat_vs_head|type)=="array" and all(.diffstat_vs_head[]; stat)
      and (.diffstat_vs_main|type)=="array" and all(.diffstat_vs_main[]; stat);
    def pr:
      exact(["number","state","is_draft","merge_state","head","base","head_sha"])
      and (.number|type)=="number" and (.state|type)=="string" and (.is_draft|type)=="boolean"
      and (.merge_state|type)=="string" and (.head|type)=="string" and (.base|type)=="string" and (.head_sha|sha);
    exact(["schema_version","observed_at","repository","provenance","target_universe","stable_controls","targets","decision","execution","command_receipts"])
    and .schema_version==1 and (.observed_at|ts) and (.repository|type)=="string"
    and (.provenance|exact(["active_branch","active_head_sha","upstream","upstream_sha","authority"]))
    and (.provenance.active_head_sha|sha) and (.provenance.upstream_sha|sha) and .provenance.authority==false
    and (.target_universe|exact(["local","remote"]))
    and all(.target_universe.local[], .target_universe.remote[]; exact(["branch","sha"]) and (.branch|type)=="string" and (.sha|sha))
    and (.stable_controls|exact(["origin_main_sha","pr34","ruleset_protection_digest","classic_protection","required_contexts","required_contexts_digest","worktrees","worktree_list_digest"]))
    and (.stable_controls.origin_main_sha|sha) and (.stable_controls.pr34|pr) and .stable_controls.pr34.number==34
    and (.stable_controls.ruleset_protection_digest|digest) and (.stable_controls.classic_protection=="absent" or .stable_controls.classic_protection=="present")
    and (.stable_controls.required_contexts|type)=="array" and all(.stable_controls.required_contexts[]; type=="string")
    and (.stable_controls.required_contexts_digest|digest)
    and (.stable_controls.worktrees|type)=="array" and all(.stable_controls.worktrees[]; exact(["path","branch"]) and (.path|type)=="string" and (.branch|type)=="string")
    and (.stable_controls.worktree_list_digest|digest)
    and (.targets|type)=="array" and (.targets|length)==3
    and all(.targets[];
      exact(["branch","pr","evidence_purpose","observed_at","local","remote","pull_request","recommendation","archive_sha","restore_command"])
      and (.branch|type)=="string" and (.pr|type)=="number" and (.evidence_purpose|type)=="string" and (.evidence_purpose|length)>0 and (.observed_at|ts)
      and (.local|ref) and (.remote|ref) and (.pull_request|pr)
      and (.recommendation|exact(["action","rationale"])) and (.recommendation.action=="retire" or .recommendation.action=="preserve") and (.recommendation.rationale|length)>0
      and (.archive_sha|sha) and (.restore_command|type)=="string" and (.restore_command|length)>0)
    and (.decision==null or (.decision|type)=="object")
    and (.execution==null or (.execution|type)=="object")
    and (.command_receipts|type)=="array"
  ' "$inventory" >/dev/null || die "schema or required-field validation failed"

  jq -e '
    ([.targets[] | [.branch,.pr]] | sort) ==
      ([ ["ci/198-gap-closure",29], ["ci/198-round5",32], ["ci/198-round6",33] ] | sort)
    and ([.targets[].branch] | unique | length)==3
    and all(.targets[];
      .pull_request.number==.pr and .pull_request.head==.branch and .pull_request.base=="main"
      and .pull_request.head_sha==.remote.sha
      and .archive_sha==.local.sha
      and .restore_command==("git branch " + .branch + " " + .local.sha)
      and (if (.local.ancestor_of_head and .local.ancestor_of_main and .remote.ancestor_of_head and .remote.ancestor_of_main
               and (.local.unique_vs_head|length)==0 and (.local.unique_vs_main|length)==0
               and (.remote.unique_vs_head|length)==0 and (.remote.unique_vs_main|length)==0
               and (.local.diffstat_vs_head|length)==0 and (.local.diffstat_vs_main|length)==0
               and (.remote.diffstat_vs_head|length)==0 and (.remote.diffstat_vs_main|length)==0)
           then .recommendation.action=="retire" else .recommendation.action=="preserve" end))
    and ([.target_universe.local[] | [.branch,.sha]] | sort) == ([.targets[] | [.branch,.local.sha]] | sort)
    and (. as $root | all(.targets[]; . as $t | any($root.target_universe.remote[]; .branch==$t.branch and .sha==$t.remote.sha)))
    and (.stable_controls | has("active_head_sha") | not)
    and (.stable_controls | has("upstream_sha") | not)
  ' "$inventory" >/dev/null || die "target mapping, recommendation, universe, or provenance-boundary invariant failed"

  local context_digest worktree_digest
  context_digest=$(jq -cS '.stable_controls.required_contexts' "$inventory" | tr -d '\n' | sha256)
  worktree_digest=$(jq -cS '.stable_controls.worktrees' "$inventory" | tr -d '\n' | sha256)
  [[ "$context_digest" == "$(jq -r '.stable_controls.required_contexts_digest' "$inventory")" ]] || die "required-context digest mismatch"
  [[ "$worktree_digest" == "$(jq -r '.stable_controls.worktree_list_digest' "$inventory")" ]] || die "worktree-list digest mismatch"
}

inventory_digest() { jq -cS 'del(.decision,.execution,.command_receipts)' "$inventory" | sha256; }

validate_markdown() {
  local digest controls_marker
  digest=$(inventory_digest)
  grep -Fq "<!-- inventory-sha256: ${digest} -->" "$decision" || die "Markdown inventory digest is absent or stale"
  while IFS=$'\t' read -r branch pr local_sha remote_sha head_sha base recommendation; do
    grep -Fq "<!-- target: ${branch}|${pr}|${local_sha}|${remote_sha}|${head_sha}|${base}|${recommendation} -->" "$decision" ||
      die "Markdown/JSON target join mismatch for $branch"
  done < <(jq -r '.targets[] | [.branch,.pr,.local.sha,.remote.sha,.pull_request.head_sha,.pull_request.base,.recommendation.action] | @tsv' "$inventory")
  controls_marker=$(jq -r '.stable_controls | [.origin_main_sha,(.pr34.number|tostring),.pr34.head_sha,.ruleset_protection_digest,.required_contexts_digest,.worktree_list_digest] | join("|")' "$inventory")
  grep -Fq "<!-- controls: ${controls_marker} -->" "$decision" || die "Markdown/JSON stable-control join mismatch"
}

live_compare() {
  if [[ -n "${PHASE198_REF_DISPOSITION_LIVE_FIXTURE:-}" ]]; then
    [[ -f "$PHASE198_REF_DISPOSITION_LIVE_FIXTURE" ]] || die "live fixture does not exist"
    jq -e --slurpfile live "$PHASE198_REF_DISPOSITION_LIVE_FIXTURE" '
      .target_universe==$live[0].target_universe and
      .stable_controls==$live[0].stable_controls and
      ([.targets[]|{branch,pr,local_sha:.local.sha,remote_sha:.remote.sha,pr_state:.pull_request.state,is_draft:.pull_request.is_draft,merge_state:.pull_request.merge_state,head:.pull_request.head,base:.pull_request.base,head_sha:.pull_request.head_sha}] | sort_by(.branch)) ==
      ([$live[0].targets[]|{branch,pr,local_sha:.local.sha,remote_sha:.remote.sha,pr_state:.pull_request.state,is_draft:.pull_request.is_draft,merge_state:.pull_request.merge_state,head:.pull_request.head,base:.pull_request.base,head_sha:.pull_request.head_sha}] | sort_by(.branch))
    ' "$inventory" >/dev/null || die "fixture live-state equality failed"
    return
  fi

  need gh
  local repo origin_main rules rules_digest contexts contexts_digest classic classic_output classic_exit
  repo=$(gh repo view --json nameWithOwner --jq .nameWithOwner 2>/dev/null) || die "could not resolve repository"
  [[ "$repo" == "$(jq -r .repository "$inventory")" ]] || die "repository mismatch"
  origin_main=$(git ls-remote --heads origin refs/heads/main | awk 'NF {print $1}')
  [[ "$origin_main" == "$(jq -r .stable_controls.origin_main_sha "$inventory")" ]] || die "origin/main drifted"

  local actual_local actual_remote
  actual_local=$(git for-each-ref --format='%(refname:short) %(objectname)' 'refs/heads/ci/198-*' | sort | jq -Rsc 'split("\n")[:-1] | map(capture("^(?<branch>[^ ]+) (?<sha>[0-9a-f]{40})$"))')
  actual_remote=$(git ls-remote --heads origin 'refs/heads/ci/198-*' | sort -k2 | jq -Rsc 'split("\n")[:-1] | map(capture("^(?<sha>[0-9a-f]{40})\\trefs/heads/(?<branch>.+)$"))')
  jq -e --argjson local "$actual_local" --argjson remote "$actual_remote" '.target_universe.local==$local and .target_universe.remote==$remote' "$inventory" >/dev/null || die "complete ci/198-* target universe drifted"

  while IFS=$'\t' read -r branch pr local_sha remote_sha state draft merge head base head_sha; do
    [[ "$(git rev-parse "refs/heads/$branch" 2>/dev/null)" == "$local_sha" ]] || die "$branch local SHA drifted"
    [[ "$(git ls-remote --heads origin "refs/heads/$branch" | awk 'NF {print $1}')" == "$remote_sha" ]] || die "$branch remote SHA drifted"
    local pr_json
    pr_json=$(gh pr view "$pr" --json number,state,isDraft,mergeStateStatus,headRefName,baseRefName,headRefOid 2>/dev/null) || die "PR #$pr unavailable"
    jq -e --argjson n "$pr" --arg state "$state" --argjson draft "$draft" --arg merge "$merge" --arg head "$head" --arg base "$base" --arg sha "$head_sha" \
      '.number==$n and .state==$state and .isDraft==$draft and .mergeStateStatus==$merge and .headRefName==$head and .baseRefName==$base and .headRefOid==$sha' <<<"$pr_json" >/dev/null || die "PR #$pr drifted"
  done < <(jq -r '.targets[] | [.branch,.pr,.local.sha,.remote.sha,.pull_request.state,.pull_request.is_draft,.pull_request.merge_state,.pull_request.head,.pull_request.base,.pull_request.head_sha] | @tsv' "$inventory")

  local pr34_json
  pr34_json=$(gh pr view 34 --json number,state,isDraft,mergeStateStatus,headRefName,baseRefName,headRefOid 2>/dev/null) || die "PR #34 unavailable"
  jq -e --argjson live "$pr34_json" '.stable_controls.pr34 == {number:$live.number,state:$live.state,is_draft:$live.isDraft,merge_state:$live.mergeStateStatus,head:$live.headRefName,base:$live.baseRefName,head_sha:$live.headRefOid}' "$inventory" >/dev/null || die "PR #34 drifted"

  rules=$(gh api "repos/${repo}/rules/branches/main" 2>/dev/null) || die "effective rules unavailable"
  set +e
  classic_output=$(gh api --include --silent "repos/${repo}/branches/main/protection" 2>&1)
  classic_exit=$?
  set -e
  if [[ $classic_exit -eq 0 ]]; then classic=present
  elif grep -Eq '^HTTP/[0-9.]+ 404 ' <<<"$classic_output"; then classic=absent
  else die "classic protection observation failed"; fi
  rules_digest=$(jq -cnS --argjson rules "$(jq -cS . <<<"$rules")" --arg classic "$classic" '{classic_protection:$classic,effective_rules:$rules}' | tr -d '\n' | sha256)
  contexts=$(jq -cS '[.[] | select(.type=="required_status_checks") | .parameters.required_status_checks[]?.context] | unique | sort' <<<"$rules")
  contexts_digest=$(printf '%s' "$contexts" | sha256)
  [[ "$rules_digest" == "$(jq -r .stable_controls.ruleset_protection_digest "$inventory")" ]] || die "ruleset/protection drifted"
  [[ "$contexts" == "$(jq -cS .stable_controls.required_contexts "$inventory")" && "$contexts_digest" == "$(jq -r .stable_controls.required_contexts_digest "$inventory")" ]] || die "required contexts drifted"

}

# Worktree comparison is kept separate because awk implementations disagree on an empty final record.
live_worktree_compare() {
  [[ -n "${PHASE198_REF_DISPOSITION_LIVE_FIXTURE:-}" ]] && return
  local actual digest
  actual=$(git worktree list --porcelain | awk 'BEGIN{RS="";FS="\n"}{p=b=""; for(i=1;i<=NF;i++){if($i~/^worktree /)p=substr($i,10); else if($i~/^branch /)b=substr($i,8)} printf "%s\t%s\n",p,b}' | jq -Rsc 'split("\n")[:-1] | map(split("\t") | {path:.[0],branch:.[1]}) | sort_by(.path)')
  digest=$(printf '%s' "$actual" | jq -cS . | tr -d '\n' | sha256)
  jq -e --argjson actual "$actual" '.stable_controls.worktrees==$actual' "$inventory" >/dev/null || die "worktree identities drifted"
  [[ "$digest" == "$(jq -r .stable_controls.worktree_list_digest "$inventory")" ]] || die "worktree digest drifted"
}

validate_inventory() {
  validate_schema
  validate_markdown
  [[ "$(jq -r '.decision==null and .execution==null and (.command_receipts|length)==0' "$inventory")" == true ]] ||
    die "inventory stage forbids decision, execution, or write-side command receipts"
  live_compare
  live_worktree_compare
}

extract_decision() {
  awk '/^<!-- maintainer-decision-json$/{on=1;next}/^-->$/{if(on){exit}}on' "$decision"
}

validate_decision() {
  validate_schema
  validate_markdown
  live_compare
  live_worktree_compare
  local payload digest subjects
  payload=$(extract_decision)
  jq -e 'type=="object" and (keys|sort)==(["option","verbatim","recorded_at","inventory_sha256","subjects"]|sort)
    and (.option=="retire" or .option=="preserve" or .option=="abort")
    and (.verbatim|type)=="string" and (.recorded_at|type)=="string"' <<<"$payload" >/dev/null || die "maintainer decision is absent or malformed"
  digest=$(inventory_digest)
  [[ "$(jq -r .inventory_sha256 <<<"$payload")" == "$digest" ]] || die "decision inventory digest mismatch"
  subjects=$(jq -cS '[.targets[]|{branch,pr,local_sha:.local.sha,remote_sha:.remote.sha,head:.pull_request.head,base:.pull_request.base,head_sha:.pull_request.head_sha}]' "$inventory")
  [[ "$(jq -cS .subjects <<<"$payload")" == "$subjects" ]] || die "decision subjects mismatch"
  case "$(jq -r .option <<<"$payload")" in
    retire) [[ "$(jq -r .verbatim <<<"$payload")" == retire ]] || die "retire must be recorded verbatim" ;;
    abort) [[ "$(jq -r .verbatim <<<"$payload")" == abort ]] || die "abort must be recorded verbatim" ;;
    preserve) [[ "$(jq -r .verbatim <<<"$payload")" == preserve* ]] || die "preserve response must be verbatim" ;;
  esac
}

if [[ "$schema_version" == 2 ]]; then
  case "$stage" in
    inventory)
      validate_inventory_v2
      echo "Phase 198 ref-disposition round 11 inventory OK: complete live namespace joined to distinct side/SHA preservation subjects; no mutation authority or receipt."
      ;;
    decision)
      validate_decision_v2
      live_compare_v2
      echo "Phase 198 ref-disposition round 11 decision OK."
      ;;
    authority)
      [[ -n "$target" ]] || die "authority requires --target"
      validate_decision_v2
      live_compare_v2
      [[ "$(jq -r .decision.option "$inventory")" == retire ]] || die "only retire grants mutation authority"
      jq -e --arg target "$target" 'any(.preservation_subjects[];.branch==$target)' "$inventory" >/dev/null || die "target is outside exact authority"
      echo "Round 11 authority OK for $target."
      ;;
    controls)
      validate_decision_v2
      [[ "$(jq -r .decision.option "$inventory")" == retire ]] || die "only retire grants mutation authority"
      validate_fixture_controls_v2
      validate_receipt_shape_v2
      echo "Round 11 stable controls OK."
      ;;
    post-target)
      validate_post_target_v2
      echo "Round 11 post-target preservation and retirement ordering OK for $target."
      ;;
    final)
      validate_final_v2
      echo "Round 11 final OK: live-derived namespaces empty; every subject remains archive/register joined; GREEN-07 Pending."
      ;;
  esac
  exit 0
fi

[[ "$schema_version" == 1 ]] || die "unsupported schema version"

case "$stage" in
  inventory)
    validate_inventory
    echo "Phase 198 ref-disposition inventory OK: exactly 3 decision targets; 3 local and 6 remote ci/198-* refs; stable controls unchanged; no mutation receipt."
    ;;
  decision)
    validate_decision
    echo "Phase 198 ref-disposition decision OK."
    ;;
  authority)
    [[ -n "$target" ]] || die "authority requires --target"
    validate_decision
    [[ "$(extract_decision | jq -r .option)" == retire ]] || die "only retire grants mutation authority"
    jq -e --arg target "$target" 'any(.targets[]; .branch==$target)' "$inventory" >/dev/null || die "target is outside exact authority"
    [[ "$(jq '.target_universe.remote|length' "$inventory")" -eq 3 ]] || die "full remote ci/198-* namespace is not the exact three-target authority set; replan before mutation"
    echo "Authority OK for $target."
    ;;
  controls|post-target|final)
    validate_decision
    die "$stage requires Plan 52 execution receipts and is fail-closed before execution begins"
    ;;
esac
