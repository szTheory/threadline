# under /test/fixtures/operator_surface/, which stays tracked and manifest-owned).
/.planning/critic-scores/
/.planning/critic-verdict-cache/
/.planning/critic-report.html
/.planning/scorecards/
/.planning/refute/
/.planning/state.json
/.planning/milestone.lock
/.planning/agent-history.json

