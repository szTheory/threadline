    {"id":"route.redaction","pattern":"/policy/redaction","path":"/audit/policy/redaction","seedResolution":"Demo seed redaction policy","role":"seeded-admin","scope":"isolated-local-demo-database"},
    {"id":"route.retention","pattern":"/policy/retention","path":"/audit/policy/retention","seedResolution":"Manifest.evidence_run_id(:offboarded_retention)","role":"seeded-admin","scope":"isolated-local-demo-database"}
