{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "automationDetails": {
        "description": {
          "text": "Hex dependency audit (mix hex.audit)"
        },
        "id": "hex-audit/"
      },
      "tool": {
        "driver": {
          "name": "mix hex.audit",
          "version": "2.6.0",
          "rules": [
            {
              "id": "HEX0002",
              "name": "RetiredPackageInvalid"
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "HEX0002",
          "ruleIndex": 0,
          "level": "warning",
          "message": {
            "text": "Dependency 'plug' '1.20.0' is retired: '(invalid) Accidental breaking change on Plug.Conn.inform'."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "mix.lock"
                },
                "region": {
                  "startLine": 3
                }
              }
            }
          ],
          "partialFingerprints": {
            "hexAudit/v1": "retired:hexpm/plug"
          }
        }
      ]
    }
  ]
}
