{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "elixir",
  "always-update": true,
  "bump-minor-pre-major": false,
  "bump-patch-for-minor-pre-major": false,
  "changelog-sections": [
    {"type": "feat", "section": "Features"},
    {"type": "fix", "section": "Bug Fixes"},
    {"type": "perf", "section": "Performance Improvements"},
    {"type": "deps", "section": "Dependencies"},
    {"type": "chore", "section": "Miscellaneous", "hidden": true}
  ],
  "packages": {
    ".": {
      "changelog-path": "CHANGELOG-GENERATED.md",
      "include-v-in-tag": true,
      "exclude-paths": [".github", ".impeccable", ".planning", "bench", "bin", "brand/assets/fonts/static", "brand/assets/fonts/variable", "brand/assets/social", "brandbook", "config", "examples", "lib/threadline/operator_surface/live/stress_live", "priv", "prompts", "scripts", "test"],
      "extra-files": [
        {"type": "generic", "path": "guides/adoption-pilot-backlog.md"},
        {"type": "generic", "path": "guides/evaluating-threadline.md"}
      ]
    }
  }
}
