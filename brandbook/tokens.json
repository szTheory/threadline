  "excluded_from_brand_scope": {
    "_notes": "These tokens are intentionally NOT mirrored in the curated brand semantic blocks above. logo-arc is brand-exclusive (it lives in the brandbook but is intentionally absent from the shipped operator-surface lane in lib/threadline/operator_surface/style.ex). The remaining names are runtime-only structural tokens that live in style.ex but are out of brand scope (rgba composites, var() aliases, status tints, op badges). The brandbook_token_parity_test asserts this gap stays intentional, not drift. The top-level `code` and `callout` token groups are likewise brand-only: style.ex defines no --tl-code-* or --tl-callout-* custom properties, so they have no operator-surface source-of-truth anchor and sit intentionally outside the mechanical parity gate. They are reconciled by brand review, not by the cross-file test — keep any color overlap (e.g. callout.warning.text) hand-aligned to the semantic lane when the semantic value changes.",
    "brand-exclusive": [
      "logo-arc"
    ],
    "runtime-only": [
      "surface-tint",
      "surface-tint-strong",
      "backdrop",
      "border-focus",
