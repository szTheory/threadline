{
  "name": "Threadline brand tokens",
  "version": "1.1.0",
  "source": "Threadline brandbook static brand artifacts, aligned with the operator surface token contract",
  "raw": {
    "color": {
      "threadline-black": "#0B1020",
      "graphite": "#141B2D",
      "surface-raised": "#1B253A",
      "surface-hover": "#202B42",
      "slate-line": "#23304A",
      "border-strong": "#2E3D5C",
      "fog": "#D7DEEA",
      "paper": "#F7F9FC",
      "mist": "#E7ECF4",
      "steel": "#73819C",
      "storm": "#3B4762",
      "ink": "#0F1728",
      "thread-blue": "#4F8CFF",
      "thread-blue-strong": "#6FA1FF",
      "stitch-blue": "#4781E6",
      "signal-cyan": "#4EDFD1",
      "iris": "#8A7CFF",
      "ember": "#FF8A5B",
      "success": "#3FD08F",
      "success-dark-text": "#5AE0A2",
      "warning": "#F3B94C",
      "warning-dark-text": "#F6C86B",
      "danger": "#F06A6A",
      "danger-dark-text": "#FF8585",
      "info-dark-text": "#9AB9FF"
    }
  },
  "typography": {
    "family": {
      "sans": "Geist, Inter, system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif",
      "mono": "IBM Plex Mono, JetBrains Mono, ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace"
    },
    "size": {
      "xs": "12px",
      "sm": "13px",
      "label": "14px",
      "ui": "15px",
      "body": "16px",
      "heading": "20px",
      "title": "24px",
      "display": "32px",
      "hero": "48px"
    },
    "lineHeight": {
      "tight": "1.15",
      "heading": "1.2",
      "label": "1.4",
      "body": "1.5",
      "prose": "1.65"
    },
    "weight": {
      "regular": "400",
      "medium": "500",
      "strong": "600"
    },
    "tracking": {
      "normal": "0",
      "caps": "0.12em",
      "caps-wide": "0.16em"
    }
  },
  "spacing": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px",
    "20": "80px"
  },
  "radius": {
    "xs": "3px",
    "sm": "4px",
    "md": "6px",
    "lg": "8px",
    "xl": "12px",
    "pill": "999px"
  },
  "border": {
    "subtle": "1px solid var(--tl-color-border)",
    "strong": "1px solid var(--tl-color-border-strong)",
    "accent": "1px solid rgba(127, 169, 255, 0.48)"
  },
  "shadow": {
    "none": "none",
    "subtle": "0 1px 2px rgba(2, 4, 10, 0.18), 0 1px 3px rgba(2, 4, 10, 0.12)",
    "popover": "0 10px 28px rgba(2, 4, 10, 0.30)",
    "raised": "0 18px 48px rgba(2, 4, 10, 0.40)"
  },
  "focus": {
    "ring": "0 0 0 3px rgba(127, 169, 255, 0.42), 0 0 0 1px #7FA9FF",
    "color": "#7FA9FF"
  },
  "code": {
    "dark-bg": "#080D1B",
    "dark-border": "#23304A",
    "dark-text": "#D7DEEA",
    "light-bg": "#EEF3FA",
    "light-border": "#C9D3E2",
    "light-text": "#0F1728",
    "prompt": "#4EDFD1",
    "comment": "#8F9DB5",
    "keyword": "#8A7CFF",
    "string": "#5AE0A2"
  },
  "callout": {
    "info": {
      "bg": "rgba(79, 140, 255, 0.16)",
      "border": "rgba(127, 169, 255, 0.44)",
      "text": "#9AB9FF"
    },
    "success": {
      "bg": "rgba(63, 208, 143, 0.16)",
      "border": "rgba(90, 224, 162, 0.44)",
      "text": "#5AE0A2"
    },
    "warning": {
      "bg": "rgba(243, 185, 76, 0.16)",
      "border": "rgba(255, 209, 102, 0.50)",
      "text": "#F6C86B"
    },
    "error": {
      "bg": "rgba(240, 106, 106, 0.16)",
      "border": "rgba(255, 133, 133, 0.48)",
      "text": "#FF8585"
    }
  },
  "state": {
    "default": "var(--tl-color-surface)",
    "hover": "var(--tl-color-surface-hover)",
    "active": "var(--tl-color-surface-selected)",
    "focus": "var(--tl-focus-ring)",
    "disabled": "rgba(143, 157, 181, 0.42)",
    "selected": "var(--tl-color-surface-selected)",
    "success": "var(--tl-color-success-text)",
    "warning": "var(--tl-color-warning-text)",
    "error": "var(--tl-color-danger)",
    "info": "var(--tl-color-info-text)",
    "subtle": "var(--tl-color-surface-raised)",
    "muted": "var(--tl-color-muted)"
  }
}
